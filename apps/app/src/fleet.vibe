// The console machines (settings, playground, logs, batch) and the gateway batch job are single-user by
// shape: the server keeps one machine instance per wallet instead of one shared instance every account
// would see and mutate. Each instance is backed by the store under "<name>:<wallet>"; the machine's own
// load-step-keep keeps concurrent writers correct, and the cache keeps streams stable.
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import * as Console from "../gen/app__console.effect.vibe"
import * as Chat from "../gen/app__console__chat.effect.vibe"
import * as Logs from "../gen/app__console__logs.effect.vibe"
import * as Batch from "../gen/app__console__batch.effect.vibe"
import * as GatewayBatch from "../gen/app__gateway__batch.effect.vibe"

export interface FleetMachine {
  get(): unknown!!
  // eslint-disable-next-line @typescript-eslint/no-explicit-any -- the channel payload type is erased at the protocol boundary
  receive(input: unknown): any!any
  changes: Stream.Stream<unknown>
}

interface Storekv {
  get(key: string): (string | undefined)!any
  set(key: string, value: string): void!any
}

// spec/app/console/index.md, "The console starts unnamed with factory defaults"
function migrateConsoleState(parsed: unknown) {
  if (parsed == undefined || typeof parsed != "object" || Array.isArray(parsed)) return parsed
  const state = parsed as { name?: unknown; username?: unknown; theme?: unknown; plain?: unknown; history?: unknown }
  return {
    name: state.name,
    username: state.username,
    theme: state.theme,
    plain: typeof state.plain == "boolean" ? state.plain : true,
    history: typeof state.history == "boolean" ? state.history : true,
  }
}

effect function buildConsole(kv: Storekv, key: string) {
  effect function load() {
    const found = try Effect.orDie(kv.get(key))
    if (found === undefined) return Console.initial
    const parsed = try Effect.orDie(Effect.try({ try: () => JSON.parse(found) as unknown, catch: () => new Console.NotAState({ input: found }) }))
    return try Effect.orDie(Console.decodeState(migrateConsoleState(parsed)))
  }
  return try Effect.orDie(Console.machineOver(load, (next) => Effect.orDie(kv.set(key, JSON.stringify(next)))))
}

interface Storekv {
  get(key: string): (string | undefined)!any
  set(key: string, value: string): void!any
}

// spec/app/console/chat.md, "A conversation is an alternating run of user and assistant messages"
function migrateChatMessage(message: unknown, inherited: string | undefined) {
  if (message == undefined || typeof message != "object" || Array.isArray(message)) return message
  const record = message as { role?: unknown; content?: unknown; model?: unknown }
  return { role: record.role, content: record.content, model: typeof record.model == "string" ? record.model : inherited }
}

function migrateChatThread(thread: unknown, rootModel: string | undefined) {
  if (thread == undefined || typeof thread != "object" || Array.isArray(thread)) return thread
  const record = thread as { id?: unknown; model?: unknown; messages?: unknown }
  const model = typeof record.model == "string" ? record.model : rootModel
  const messages = Array.isArray(record.messages) ? record.messages.map((message) => migrateChatMessage(message, model)) : record.messages
  return { id: record.id, model, messages }
}

function migrateChatState(parsed: unknown) {
  if (parsed == undefined || typeof parsed != "object" || Array.isArray(parsed)) return parsed
  const state = parsed as { threads?: unknown; active?: unknown; model?: unknown }
  const rootModel = typeof state.model == "string" ? state.model : undefined
  const threads = Array.isArray(state.threads) ? state.threads.map((thread) => migrateChatThread(thread, rootModel)) : state.threads
  return { threads, active: state.active, model: state.model }
}

effect function buildChat(kv: Storekv, key: string) {
  effect function load() {
    const found = try Effect.orDie(kv.get(key))
    if (found === undefined) return Chat.initial
    const parsed = try Effect.orDie(Effect.try({ try: () => JSON.parse(found) as unknown, catch: () => new Chat.NotAState({ input: found }) }))
    return try Effect.orDie(Chat.decodeState(migrateChatState(parsed)))
  }
  return try Effect.orDie(Chat.machineOver(load, (next) => Effect.orDie(kv.set(key, JSON.stringify(next)))))
}

interface Storekv {
  get(key: string): (string | undefined)!any
  set(key: string, value: string): void!any
}

// spec/app/console/logs.md, "A request row records what ran, how it ended and what it cost":
// rows written before the entry carried its start time have none — they decode with time 0,
// the unknown time that keeps their frozen ageDays.
function withEntryTimes(parsed: unknown) {
  if (parsed == undefined || typeof parsed != "object" || !Array.isArray((parsed as { entries?: unknown }).entries)) return parsed
  const state = parsed as { entries: Array<Record<string, unknown>> }
  return { ...state, entries: state.entries.map((entry) => (typeof entry.time == "number" ? entry : { ...entry, time: 0 })) }
}

effect function buildLogs(kv: Storekv, key: string) {
  effect function load() {
    const found = try Effect.orDie(kv.get(key))
    if (found === undefined) return Logs.initial
    const parsed = try Effect.orDie(Effect.try({ try: () => JSON.parse(found) as unknown, catch: () => new Logs.NotAState({ input: found }) }))
    return try Effect.orDie(Logs.decodeState(withEntryTimes(parsed)))
  }
  return try Effect.orDie(Logs.machineOver(load, (next) => Effect.orDie(kv.set(key, JSON.stringify(next)))))
}

interface Storekv {
  get(key: string): (string | undefined)!any
  set(key: string, value: string): void!any
}

effect function buildBatch(kv: Storekv, key: string) {
  effect function load() {
    const found = try Effect.orDie(kv.get(key))
    if (found === undefined) return Batch.initial
    const parsed = try Effect.orDie(Effect.try({ try: () => JSON.parse(found) as unknown, catch: () => new Batch.NotAState({ input: found }) }))
    return try Effect.orDie(Batch.decodeState(parsed))
  }
  return try Effect.orDie(Batch.machineOver(load, (next) => Effect.orDie(kv.set(key, JSON.stringify(next)))))
}

effect function buildGatewayBatch(kv: Storekv, key: string) {
  effect function load() {
    const found = try Effect.orDie(kv.get(key))
    if (found === undefined) return GatewayBatch.initial
    const parsed = try Effect.orDie(Effect.try({ try: () => JSON.parse(found) as unknown, catch: () => new GatewayBatch.NotAState({ input: found }) }))
    return try Effect.orDie(GatewayBatch.decodeState(parsed))
  }
  return try Effect.orDie(GatewayBatch.machineOver(load, (next) => Effect.orDie(kv.set(key, JSON.stringify(next)))))
}

export service Fleet {
  static readonly key = "@repo/app/fleet"
  machine(name: string, wallet: string): FleetMachine!!
}

/** The cache cannot hold every wallet's machines forever, so past maxCachedMachines the
 * longest-untouched entries evict. Eviction is safe because every machine is event-sourced:
 * machineOver applies each event to what the store holds when it is sent, so a dropped object
 * loses nothing and reloads on next access. A machine with a live changes subscriber is never
 * evicted — dropping it would strand the stream on an instance no future write reaches, since
 * writes always go through a fresh machine() lookup. */
const maxCachedMachines = 200

interface CachedMachine {
  machine: FleetMachine
  subscribers: number
}

function trackedEntry(machine: FleetMachine): CachedMachine {
  const entry: CachedMachine = { machine, subscribers: 0 }
  entry.machine = {
    ...machine,
    changes: Stream.unwrap(sync(() => {
      entry.subscribers += 1
      return machine.changes
    })).pipe(Stream.ensuring(sync(() => {
      entry.subscribers -= 1
    }))),
  }
  return entry
}

export const fleetLive = Layer.effect(Fleet, effect {
  const cache = try Ref.make(new Map<string, CachedMachine>())
  const kv = try KeyValueStore.KeyValueStore
  return {
    effect machine(name: string, wallet: string) {
      const key = name + ":" + wallet
      const cached = try Ref.modify(cache, (current: Map<string, CachedMachine>) => {
        const held = current.get(key)
        if (held == undefined) return [undefined, current] as const
        const next = new Map(current)
        next.delete(key)
        next.set(key, held)
        return [held.machine, next] as const
      })
      if (cached != undefined) return cached
      // eslint-disable-next-line @typescript-eslint/no-explicit-any -- the four machine shapes unify only as erasure
      const built: any = name == "console" ? try buildConsole(kv, key)
        : name == "console__chat" ? try buildChat(kv, key)
        : name == "console__logs" ? try buildLogs(kv, key)
        : name == "gateway-batch" ? try buildGatewayBatch(kv, key)
        : try buildBatch(kv, key)
      return try Ref.modify(cache, (current: Map<string, CachedMachine>) => {
        const existing = current.get(key)
        if (existing != undefined) return [existing.machine, current] as const
        const entry = trackedEntry(built as FleetMachine)
        const next = new Map(current)
        next.set(key, entry)
        for (const [held, cachedEntry] of next) {
          if (next.size <= maxCachedMachines) break
          if (held == key || cachedEntry.subscribers > 0) continue
          next.delete(held)
        }
        return [entry.machine, next] as const
      })
    },
  }
})
