// spec/app/nav.md, "Story: Move around"
import { Machine, stored } from "../../gen/app__nav.effect.vibe"
import type { Page } from "../../gen/app__nav.ts"

/** The navigator, kept under "nav2": the page model changed when observability merged into inference, and a state written against it is not a state now. */
export const nav = stored("nav2")

/** The navigation state as it is kept now. */
export effect function current() {
  const machine = try Machine
  return try machine.get()
}

/** A page opened from a link in the page. */
export effect function open(page: Page) {
  const machine = try Machine
  return try machine.send({ type: "open", page })
}

/** The browser's own back button. */
export effect function back() {
  const machine = try Machine
  return try machine.send({ type: "back" })
}

/** An event from anywhere untrusted, decoded before the rules see it. */
export effect function dispatch(input: unknown) {
  const machine = try Machine
  return try machine.receive(input)
}
