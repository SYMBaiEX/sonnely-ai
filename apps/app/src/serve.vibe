module node {
  import { createServer } from "node:http"
  import { NodeHttpServer } from "@effect/platform-node"
  /** An HTTP server on `port` (0 picks a free one). */
  export function listening(port: number, create = createServer) {
    return NodeHttpServer.layer(create, { port, gracefulShutdownTimeout: 0 })
  }
}
import { listening } from node

export { listening }

module kv {
  import * as NodeFileSystem from "@effect/platform-node/NodeFileSystem"
  import { Layer } from "effect"
  import * as KeyValueStore from "effect/persistence/KeyValueStore"
  /** The KeyValueStore the machines are kept in, under `dir`. */
  export function store(dir: string) {
    return Layer.provide(KeyValueStore.layerFileSystem(dir), NodeFileSystem.layer)
  }
}
import { store } from kv

export { store }

/** The API routers and the page's files in `web`, on `listener`, over `machines`. */
export function serve(web: string, listener: any, api: any, machines: any): Layer.Layer<any, unknown, never> {
  const app = Layer.provideMerge(HttpStaticServer.layer({ root: web, spa: true }), api)
  return Layer.provideMerge(HttpRouter.serve(app, { disableLogger: true, disableListenLog: true }), Layer.provideMerge(machines, listener)) as Layer.Layer<any, unknown, never>
}
