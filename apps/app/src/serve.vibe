module node {
  import { createServer } from "node:http"
  import { readFileSync } from "node:fs"
  import { NodeHttpServer } from "@effect/platform-node"
  const drainUnderRailwaySigtermWindow = "25 seconds" as const
  export function listening(port: number, create = createServer) {
    return NodeHttpServer.layer(create, { port, gracefulShutdownTimeout: drainUnderRailwaySigtermWindow })
  }
  export function indexHtml(web: string) {
    return readFileSync(web + "/index.html")
  }
}
import { indexHtml, listening } from node
import { stateStore, store } from "./store.ts"
import { validWallet } from "./api/session/signin.ts"

export { listening }

export { stateStore, store }

/** Production boot misconfiguration: the process must not come up to serve traffic. */
export error StartupConfig { missing: string[] }

function setting(name: string) {
  return Config.withDefault(Config.String(name), "")
}

function seededWallets(seed: string) {
  return seed.split(",").map((wallet) => wallet.trim()).filter((wallet) => wallet != "")
}

/** Fails fast when production would boot open or dark: no operator seed, wrong cluster, no billing
 * target or no usable inference provider. The operator roster seeds from SONNELY_ADMIN_WALLETS
 * (with SONNELY_OPERATORS as its legacy spelling), SONNELY_SUPPORT_WALLETS and
 * SONNELY_FINANCE_WALLETS, and an empty admin seed leaves the roster bootstrap open to the first
 * signer. Provider keys gate inference through managedProviderKey in gateway/providers.ts: a key
 * that is unset, paused or behind a public-inference kill switch serves nothing, so production
 * refuses to boot an inference product with zero usable providers. */
export effect function validateStartup() {
  const nodeEnv = setting("NODE_ENV") catch () => ""
  const vercelEnv = setting("VERCEL_ENV") catch () => ""
  if (nodeEnv != "production" && vercelEnv != "production") return
  const missing: string[] = []
  const admins = seededWallets((try setting("SONNELY_ADMIN_WALLETS")) + "," + (try setting("SONNELY_OPERATORS")))
  const support = seededWallets(try setting("SONNELY_SUPPORT_WALLETS"))
  const finance = seededWallets(try setting("SONNELY_FINANCE_WALLETS"))
  if (admins.length == 0) {
    missing.push("SONNELY_ADMIN_WALLETS must seed at least one operator wallet")
  }
  if ([...admins, ...support, ...finance].some((wallet) => !validWallet(wallet))) {
    missing.push("An operator wallet seed holds a value that is not a Solana address")
  }
  if ((try setting("SOLANA_BILLING_CLUSTER")) != "mainnet") {
    missing.push("SOLANA_BILLING_CLUSTER must be mainnet in production")
  }
  if ((try setting("SOLANA_TREASURY")) == "") missing.push("SOLANA_TREASURY is required in production")
  if ((try setting("SOLANA_RPC_URL")) == "") missing.push("SOLANA_RPC_URL is required in production")
  if ((try setting("SONNELY_PUBLIC_INFERENCE")) != "true") {
    missing.push("SONNELY_PUBLIC_INFERENCE must be true in production: without it every provider key is unusable")
  }
  const paused = new Set(seededWallets(try setting("SONNELY_PAUSED_PROVIDERS")))
  const nearKey = try setting("NEAR_AI_API_KEY")
  const phalaKey = try setting("PHALA_AI_API_KEY")
  const tinfoilKey = try setting("TINFOIL_API_KEY")
  const usable = [
    { provider: "near-ai", key: nearKey },
    { provider: "phala", key: phalaKey },
    { provider: "tinfoil", key: tinfoilKey },
  ].filter((candidate) => candidate.key.trim() != "" && !paused.has(candidate.provider))
  if (usable.length == 0) {
    missing.push("At least one inference provider key (NEAR_AI_API_KEY, PHALA_AI_API_KEY, TINFOIL_API_KEY) must be set and unpaused in production")
  }
  if (missing.length == 0) return
  try Console.error("Refusing to start in production:\n" + missing.map((line) => "  - " + line).join("\n"))
  throw new StartupConfig({ missing })
}

const fileRequest = (url: string) => /\.[A-Za-z0-9]+$/.test(url.split("?")[0] ?? "")

// eslint-disable-next-line @typescript-eslint/no-explicit-any -- layers are composed opaquely here
const staticFiles = (web: string): Layer.Layer<any, unknown, never> => {
  let index: Buffer | undefined
  return Layer.unwrap(
    Effect.map(HttpStaticServer.make({ root: web, spa: true }), (app) =>
      HttpRouter.add(
        "GET",
        "/*",
        HttpEffect.withPreResponseHandler(
          app.pipe(Effect.catch(HttpServerRespondable.toResponse)),
          (request, response) =>
            response.status === 404 &&
            !request.url.startsWith("/api/") &&
            ((request.headers["accept"] ?? "").includes("text/html") || !fileRequest(request.url))
              ? Effect.try(() => (index ??= indexHtml(web))).pipe(
                  Effect.map((body) =>
                    HttpServerResponse.uint8Array(body, { contentType: "text/html" })
                  ),
                  Effect.catch(() => Effect.succeed(response)),
                )
              : Effect.succeed(response),
        ),
      ),
    ) as never,
  )
}

// eslint-disable-next-line @typescript-eslint/no-explicit-any -- layers are composed opaquely here
export function serve(web: string, listener: any, api: any, machines: any): Layer.Layer<any, unknown, never> {
  const app = Layer.provideMerge(staticFiles(web), api)
  // eslint-disable-next-line @typescript-eslint/no-explicit-any -- layers are composed opaquely here
  return Layer.provideMerge(HttpRouter.serve(app, { disableLogger: true, disableListenLog: true }), Layer.provideMerge(machines, listener)) as Layer.Layer<any, unknown, never>
}
