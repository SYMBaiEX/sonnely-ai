// spec/app/support.md, "Story: Open a request"
import { Machine, stored } from "../../gen/app__support.effect.vibe"
import type { Tickets } from "../../gen/app__support.ts"
import { machineApi } from "../machines.vibe"
import { stateStore } from "../serve.vibe"

function project(state: Tickets, wallet: string): Tickets {
  return {
    tickets: state.tickets
      .filter((ticket) => ticket.wallet == wallet)
      .map((ticket) => ({ ...ticket, replies: ticket.replies.filter((r) => r.visibility == "Public") })),
  }
}

export const supportApi = Layer.unwrap(effect {
  return machineApi("support", try Machine, { events: ["open", "reply"], bind: ["wallet"] }, { visibility: "user", project })
})

/** The queue machine, kept under "support". */
export const support = stored("support")

/** An event from anywhere untrusted, decoded before the rules see it. */
export effect function dispatch(input: unknown) {
  const machine = try Machine
  return try machine.receive(input)
}

export function supportState(dir: string) {
  return Layer.provide(support, stateStore(dir))
}
