// spec/app/support.md, "Story: Open a request": the queue behind the verified-session boundary.
// A customer opens and replies on their own requests and reads only their own thread's public
// replies; a listed operator reads the whole queue — internal notes included — and is the only
// one who may send the staff events, with the staff author forced to the operator's own wallet.
import { Machine, opaque, stored } from "../../gen/app__support.effect.vibe"
import * as Admin from "../../gen/app__admin.effect.vibe"
import type { Tickets } from "../../gen/app__support.ts"
import { machineRegistration } from "../machines.vibe"
import { stateStore } from "../serve.vibe"
import { operatorRequired, operatorWithRoles } from "./admin.vibe"
import { authenticatedWallet } from "./session.vibe"

opaque.textLength = (text) => text.length

const noStore = { "cache-control": "no-store" }

function project(state: Tickets, wallet: string): Tickets {
  return {
    tickets: state.tickets
      .filter((ticket) => ticket.wallet == wallet)
      .map((ticket) => ({ ...ticket, replies: ticket.replies.filter((r) => r.visibility == "Public") })),
  }
}

interface QueueMachine {
  get(): unknown!!
  receive(input: unknown): any!any
  changes: Stream.Stream<unknown>
}

effect function getState(admin: Admin.Machine.Shape, m: QueueMachine) {
  const wallet = try authenticatedWallet()
  if (wallet == "") return try HttpServerResponse.json({ error: "sign in required" }, { status: 401, headers: noStore })
  const state = try m.get()
  const operator = try operatorRequired(admin)
  return try HttpServerResponse.json(operator != "" ? state : project(state as Tickets, wallet), { headers: noStore })
}

effect function getStream(admin: Admin.Machine.Shape, m: QueueMachine) {
  const wallet = try authenticatedWallet()
  if (wallet == "") return try HttpServerResponse.json({ error: "sign in required" }, { status: 401, headers: noStore })
  const operator = try operatorRequired(admin)
  const full = operator != ""
  const pushes = Stream.map(m.changes, (raw) => `data: ${JSON.stringify(full ? raw : project(raw as Tickets, wallet))}\n\n`)
  return HttpServerResponse.stream(Stream.encodeText(pushes), {
    contentType: "text/event-stream",
    headers: noStore,
  })
}

// Customer events stay the customer's: open binds its wallet to the session, and a customer reply
// reaches only a ticket the session wallet itself opened — never one another wallet did. Staff
// events are the Support and Admin roles' alone, and a staff reply's author is forced to the
// operator's wallet — never a wallet the client supplied. A write answers as a read does: the
// operator's full queue or the wallet's own projected threads; a refusal never carries state.
const customerEvents = ["open", "reply"]
const staffEvents = ["staffReply", "setState", "assignOwner"]

effect function postEvent(admin: Admin.Machine.Shape, m: QueueMachine) {
  const request = try HttpServerRequest.HttpServerRequest
  if (!request.headers["content-type"]?.startsWith("application/json")) {
    return try HttpServerResponse.json({ error: "send application/json" }, { status: 415, headers: noStore })
  }
  const wallet = try authenticatedWallet()
  if (wallet == "") return try HttpServerResponse.json({ ok: false, error: "sign in required" }, { status: 401, headers: noStore })
  const input = (request.json catch () => undefined) as { type?: unknown; id?: unknown } | undefined
  if (input == undefined || typeof input.type != "string" || (!customerEvents.includes(input.type as string) && !staffEvents.includes(input.type as string))) {
    return try HttpServerResponse.json({ ok: false, error: "This event is not yours to send." }, { status: 403, headers: noStore })
  }
  const bound = input as Record<string, unknown>
  bound["now"] = try Clock.currentTimeMillis
  let operator = try operatorRequired(admin)
  if (staffEvents.includes(input.type as string)) {
    const staff = try operatorWithRoles(admin, ["support", "admin"])
    if (staff == "") return try HttpServerResponse.json({ ok: false, error: "support or administrator access required" }, { status: 403, headers: noStore })
    operator = staff
    if ("author" in bound) bound["author"] = staff
  } else if ("wallet" in bound) {
    bound["wallet"] = wallet
  }
  if (input.type == "reply" && typeof input.id == "string") {
    const tickets = ((try m.get()) as Tickets)
    const ticket = tickets.tickets.find((row) => row.id == (input.id as string))
    if (ticket == undefined || ticket.wallet == "" || ticket.wallet != wallet) {
      return try HttpServerResponse.json({ ok: false, error: "This request is not yours to reply on." }, { status: 403, headers: noStore })
    }
  }
  const sent = m.receive(bound) catch (error) => error
  const rejected = sent as { _tag?: string }
  if (rejected && typeof rejected === "object" && "_tag" in rejected) {
    const status = rejected._tag === "NotAnEvent" ? 400 : rejected._tag === "Rejected" ? 409 : 500
    return try HttpServerResponse.json({ ok: false, error: rejected._tag }, { status, headers: noStore })
  }
  return try HttpServerResponse.json({ ok: true, state: operator != "" ? sent : project(sent as Tickets, wallet) }, { headers: noStore })
}

export const supportApi = Layer.unwrap(effect {
  const admin = try Admin.Machine
  const queue = try Machine
  return Layer.mergeAll(
    HttpRouter.add("GET", "/api/machines/support", getState(admin, queue)),
    HttpRouter.add("POST", "/api/machines/support", provideService(postEvent(admin, queue), HttpServerRequest.MaxBodySize, ByteSize.kibibytes(256))),
    HttpRouter.add("GET", "/api/machines/support/stream", getStream(admin, queue)),
    machineRegistration("support", queue, { visibility: "user", project }),
  )
})

/** The queue machine, kept under "support". */
export const support = stored("support")

/** An event from anywhere untrusted, decoded before the rules see it. */
export effect function dispatch(input: unknown) {
  const machine = try Machine
  return try machine.receive(input)
}

export function supportState(dir: string) {
  return Layer.provide(support, stateStore(dir))
}
