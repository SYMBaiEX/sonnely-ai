// spec/app/keys.md, "Story: Issue a key"
import { Machine, stored } from "../../gen/app__keys.effect.vibe"
import { machineApi } from "../machines.vibe"
import { store } from "../serve.vibe"

export const keysApi = Layer.unwrap(effect {
  return machineApi("workspace-keys", try Machine)
})

/** The registry machine, kept under "workspace-keys". */
export const keys = stored("workspace-keys")

/** An event from anywhere untrusted, decoded before the rules see it. */
export effect function dispatch(input: unknown) {
  const machine = try Machine
  return try machine.receive(input)
}

export function keysState(dir: string) {
  return Layer.provide(keys, store(dir))
}
