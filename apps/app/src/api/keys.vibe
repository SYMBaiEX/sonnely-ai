// spec/app/keys.md, "Story: Issue a key": the workspace-key registry behind the verified-session
// boundary. Reads project the requesting wallet's keys plus project keys of teams it manages, and
// every write's trusted sender is derived inside the shell — never a wallet or sender supplied by
// the client. A key scoped to a team project names only a project whose owning team the wallet owns
// or administers: any other id is another workspace's.
import * as Keys from "../../gen/app__keys.effect.vibe"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import * as Teams from "../../gen/app__teams.effect.vibe"
import { sessionBoundFrames } from "../machines.vibe"
import { stateStore } from "../serve.vibe"
import { authenticatedSession, authenticatedWallet } from "./session.vibe"
import { managedProjectsFor } from "./teams.vibe"

const noStore = { "cache-control": "no-store" }

effect function reply(value: unknown, status: number = 200) {
  return try HttpServerResponse.json(value, { status, headers: noStore })
}

function project(state: Keys.Keys, wallet: string, projectIds: readonly string[]) {
  const managed = new Set(projectIds)
  return { keys: state.keys.filter((key) => key.wallet == wallet || (key.project != "" && managed.has(key.project))) }
}

effect function projectState(state: Keys.Keys, wallet: string) {
  return project(state, wallet, try managedProjectsFor(wallet))
}

effect function managesProject(projectId: string, wallet: string) {
  const service = try Effect.serviceOption(Teams.Machine)
  if (!Option.isSome(service)) return false
  const directory = try service.value.get()
  return Teams.teamOfProject(directory, projectId).some((team) => Teams.manages(team, wallet))
}

effect function getState(keys: Keys.Machine.Shape) {
  const wallet = try authenticatedWallet()
  if (wallet == "") return try reply({ error: "sign in required" }, 401)
  return try reply(try projectState(try keys.get(), wallet))
}

effect function postEvent(keys: Keys.Machine.Shape) {
  const request = try HttpServerRequest.HttpServerRequest
  if (!request.headers["content-type"]?.startsWith("application/json")) {
    return try reply({ error: "send application/json" }, 415)
  }
  const wallet = try authenticatedWallet()
  if (wallet == "") return try reply({ ok: false, error: "sign in required" }, 401)
  const input = (request.json catch () => undefined) as { type?: unknown; project?: unknown; id?: unknown } | undefined
  if (input == undefined || typeof input.type != "string" || !["create", "update", "revoke"].includes(input.type as string)) {
    return try reply({ ok: false, error: "This event is not yours to send." }, 403)
  }
  if (input.type == "create" && typeof input.project == "string" && input.project != "" && !(try managesProject(input.project, wallet))) {
    return try reply({ ok: false, error: "This project is not yours to scope a key to." }, 403)
  }
  let sender = wallet
  if (input.type == "revoke" && typeof input.id == "string") {
    const key = (try keys.get()).keys.find((entry) => entry.id == input.id)
    if (key != undefined && key.wallet != wallet) {
      if (key.project == "" || !(try managesProject(key.project, wallet))) {
        return try reply({ ok: false, error: "This key is not yours to revoke." }, 403)
      }
      sender = key.wallet
    }
  }
  const sent = keys.receive(input, sender) catch (error) => error
  const rejected = sent as { _tag?: string }
  if (rejected && typeof rejected == "object" && "_tag" in rejected) {
    const status = rejected._tag == "NotAnEvent" ? 400 : rejected._tag == "Rejected" ? 409 : 500
    return try reply({ ok: false, error: rejected._tag }, status)
  }
  return try reply({ ok: true, state: try projectState(sent as Keys.Keys, wallet) })
}

effect function getStream(keys: Keys.Machine.Shape) {
  const session = try authenticatedSession()
  const wallet = session.wallet
  if (wallet == "") return try reply({ error: "sign in required" }, 401)
  const frames = try sessionBoundFrames(keys.changes, wallet, session.digest)
  const pushes = Stream.mapEffect(frames, (state) => effect {
    const visible = try projectState(state, wallet)
    return `data: ${JSON.stringify(visible)}\n\n`
  })
  return HttpServerResponse.stream(Stream.encodeText(pushes), {
    contentType: "text/event-stream",
    headers: noStore,
  })
}

export const keysApi = Layer.unwrap(effect {
  const keys = try Keys.Machine
  return Layer.mergeAll(
    HttpRouter.add("GET", "/api/machines/workspace-keys", getState(keys)),
    HttpRouter.add("POST", "/api/machines/workspace-keys", provideService(postEvent(keys), HttpServerRequest.MaxBodySize, ByteSize.kibibytes(256))),
    HttpRouter.add("GET", "/api/machines/workspace-keys/stream", getStream(keys)),
  )
})

function withRefundRefs(parsed: unknown) {
  if (parsed == undefined || typeof parsed != "object" || Array.isArray(parsed) || "refundRefs" in parsed) return parsed
  return { ...(parsed as Record<string, unknown>), refundRefs: [] }
}

/** The registry machine, kept under "workspace-keys". Registries written before refunds carried
 * references decode with none recorded. */
export const keys = Layer.effect(Keys.Machine, effect {
  const store = try KeyValueStore.KeyValueStore
  effect function load() {
    const found = try store.get("workspace-keys")
    if (found === undefined) return Keys.initial
    const parsed = try Effect.try({ try: () => JSON.parse(found) as unknown, catch: () => new Keys.NotAState({ input: found }) })
    return try Keys.decodeState(withRefundRefs(parsed))
  }
  return try Keys.machineOver(load, (next) => Effect.orDie(store.set("workspace-keys", JSON.stringify(next))))
})

/** An event from anywhere untrusted, decoded before the rules see it. */
export effect function dispatch(input: unknown, by: unknown) {
  const machine = try Keys.Machine
  return try machine.receive(input, try Keys.decodeSender(by))
}

export function keysState(dir: string) {
  return Layer.provide(keys, stateStore(dir))
}
