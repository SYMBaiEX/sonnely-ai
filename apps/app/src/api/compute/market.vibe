// spec/app/compute/market.md, "Story: Allocate provider capacity"
import { Machine, stored } from "../../../gen/app__compute__market.effect.vibe"
import { machineApi } from "../../machines.vibe"
import { stateStore } from "../../serve.vibe"

/** The capacity offers, kept under "market". */
export const market = stored("market")

export const marketApi = Layer.unwrap(effect {
  return machineApi("market", try Machine, { events: [] })
})

export function marketState(dir: string) {
  return Layer.provide(market, stateStore(dir))
}

/** An event from anywhere untrusted, decoded before the rules see it. */
export effect function dispatch(input: unknown) {
  return try (try Machine).receive(input)
}
