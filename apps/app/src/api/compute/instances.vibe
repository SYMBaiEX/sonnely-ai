// spec/app/compute/instances.md, "Story: Rent a confidential machine"
import * as Instances from "../../../gen/app__compute__instances.effect.vibe"
import * as Ledger from "../../../gen/app__billing__ledger.effect.vibe"
import { machineReadApi } from "../../machines.vibe"
import { store } from "../../serve.vibe"
import { authenticatedWallet } from "../session.vibe"

/** The runs, kept under "instances". */
export const instances = Instances.stored("instances")

const noStore = { "cache-control": "no-store" }

effect function reply(value: unknown, status: number = 200) {
  return try HttpServerResponse.json(value, { status, headers: noStore })
}

// spec/app/compute/instances.md, "A wallet opens a run for a supported window and a valid workload":
// the ledger hold under the run id comes first; a run the ledger cannot cover never opens.
effect function openRun() {
  const request = try HttpServerRequest.HttpServerRequest
  if (!request.headers["content-type"]?.startsWith("application/json")) {
    return try reply({ ok: false, error: "send application/json" }, 415)
  }
  const sessionWallet = try authenticatedWallet()
  if (sessionWallet == "") return try reply({ ok: false, error: "sign in required" }, 401)
  const raw = request.json catch () => undefined
  const parsed = Instances.parseEvent(raw)
  if (parsed == undefined || parsed.type != "open") {
    return try reply({ ok: false, error: "A compute open event is required." }, 400)
  }
  const event = { ...parsed, wallet: sessionWallet }
  const runs = try Instances.Machine
  const current = try runs.get()
  const existing = current.runs.find((r) => r.wallet == event.wallet && r.reference == event.reference)
  if (existing != undefined) return try reply({ ok: true, id: existing.id, duplicate: true })
  if (!Instances.canOpen(current, event.id, event.reference, event.wallet, event.spec, event.minutes)) {
    return try reply({ ok: false, error: "This run is not available for that wallet, workload, window or capacity." }, 409)
  }
  const ledger = try Ledger.Machine
  const hold = Instances.quote(event.spec, event.minutes)
  const reserved = ledger.send({ type: "reserve", wallet: event.wallet, detail: event.id, amount: hold }) catch (e) => e
  if (reserved instanceof Ledger.Rejected) {
    return try reply({ ok: false, error: "Add credits to cover the quoted maximum." }, 402)
  }
  const opened = runs.send(event) catch (e) => e
  if (opened instanceof Instances.Rejected) {
    ledger.send({ type: "release", wallet: event.wallet, detail: event.id }) catch () => undefined
    return try reply({ ok: false, error: "This run is no longer available." }, 409)
  }
  return try reply({ ok: true, id: event.id })
}

// spec/app/compute/instances.md, "A running or provisioning run can be asked to stop":
// only the wallet that opened the run may ask.
effect function stopRun() {
  const request = try HttpServerRequest.HttpServerRequest
  if (!request.headers["content-type"]?.startsWith("application/json")) {
    return try reply({ ok: false, error: "send application/json" }, 415)
  }
  const raw = request.json catch () => undefined
  const input = raw as { id?: unknown } | undefined
  const id = typeof input?.id == "string" ? input.id : ""
  const wallet = try authenticatedWallet()
  if (wallet == "") return try reply({ ok: false, error: "sign in required" }, 401)
  if (id == "") return try reply({ ok: false, error: "A run id is required." }, 400)
  const runs = try Instances.Machine
  const current = try runs.get()
  const run = current.runs.find((r) => r.id == id)
  if (run == undefined || run.wallet != wallet) return try reply({ ok: false, error: "Compute run not found." }, 404)
  const stopped = runs.send({ type: "stop", id }) catch (e) => e
  if (stopped instanceof Instances.Rejected) return try reply({ ok: false, error: "This run can no longer stop." }, 409)
  return try reply({ ok: true })
}

export const instancesApi = Layer.unwrap(effect {
  const runs = try Instances.Machine
  return Layer.mergeAll(
    machineReadApi("instances", runs),
    HttpRouter.add("POST", "/api/compute/runs", provideService(openRun(), HttpServerRequest.MaxBodySize, ByteSize.kibibytes(256))),
    HttpRouter.add("POST", "/api/compute/runs/stop", provideService(stopRun(), HttpServerRequest.MaxBodySize, ByteSize.kibibytes(256))),
  )
})

export function instancesState(dir: string) {
  return Layer.provide(instances, store(dir))
}

/** An event from anywhere untrusted, decoded before the rules see it. */
export effect function dispatch(input: unknown) {
  return try (try Instances.Machine).receive(input)
}
