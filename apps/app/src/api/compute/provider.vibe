// spec/app/compute/instances.md, "Story: Rent a confidential machine": the local provider that stands in
// for Phala (Blackboxes) and Boat (Dry Docks). It launches queued runs, verifies a Blackbox's attestation,
// runs a Dry Dock's build, honours a stop, expires a run at the end of its lease, and settles it.
import type { Event, Run } from "../../../gen/app__compute__instances.ts"
import { Machine, settledCharge } from "../../../gen/app__compute__instances.effect.vibe"
import * as Ledger from "../../../gen/app__billing__ledger.effect.vibe"

const POLL = "500 millis"
const DOCK_BUILD_MS = 15_000

/** What the provider does next for a run, or nothing while it waits on the wallet or the clock. */
function nextEvent(run: Run, runningForMs: number): Event | undefined {
  const seconds = Math.max(0, Math.min(run.minutes * 60, Math.floor(runningForMs / 1000)))
  switch (run.phase) {
    case "Queued":
      if (run.stopRequested) return { type: "abandon", id: run.id, result: "Stopped" }
      return { type: "launch", id: run.id }
    case "Provisioning":
      if (run.stopRequested) return { type: "tearDown", id: run.id, result: "Stopped" }
      return run.kind === "Blackboxes" ? { type: "attest", id: run.id } : { type: "work", id: run.id }
    case "Running":
      if (run.stopRequested) return { type: "tearDown", id: run.id, result: "Stopped" }
      if (run.kind === "DryDocks" && runningForMs >= DOCK_BUILD_MS) return { type: "tearDown", id: run.id, result: "Completed" }
      if (runningForMs >= run.minutes * 60_000) return { type: "tearDown", id: run.id, result: "Expired" }
      return undefined
    case "Teardown":
      return { type: "settleRun", id: run.id, seconds, metered: run.kind === "DryDocks" ? seconds * 5 : 0 }
    default:
      return undefined
  }
}

/** Drives one run through provisioning, attestation and teardown until it settles. */
effect function supervise(id: string) {
  const machine = try Machine
  let pollsRunning = 0
  for (;;) {
    const state = try machine.get()
    const run = state.runs.find((r) => r.id === id)
    if (run === undefined || run.phase === "Settled") return
    if (run.phase === "Running") pollsRunning += 1
    const runningFor = pollsRunning * 500
    const event = nextEvent(run, runningFor)
    let moneyReady = true
    if (event?.type === "settleRun" || event?.type === "abandon" || event?.type === "decline") {
      const charge = event.type === "settleRun" ? settledCharge(run, event.seconds, event.metered).charged : 0
      const ledger = try Ledger.Machine
      const settled = ledger.send({ type: "settleHold", wallet: run.wallet, detail: run.id, amount: charge }) catch (e) => e
      moneyReady = !(settled instanceof Ledger.Rejected)
    }
    if (event !== undefined && moneyReady) machine.send(event) catch () => undefined
    try sleep(POLL)
  }
}

/** Watches the runs: every run that is not settled gets its own supervisor fiber. */
effect function watch() {
  const machine = try Machine
  const seen = new Set<string>()
  for try (const state of machine.changes) {
    for (const run of state.runs) {
      if (run.phase !== "Settled" && !seen.has(run.id)) {
        seen.add(run.id)
        fork.detached supervise(run.id)
      }
    }
  }
}

export const providerWorker = Layer.effectDiscard(effect {
  fork.detached watch()
})
