// spec/app/admin/index.md, "Story: Moderate accounts": the admin machine behind its operator
// boundary, the referrals machine, and the joined read the admin views make over shared state.
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import * as Admin from "../../gen/app__admin.effect.vibe"
import * as Crm from "../../gen/app__admin__crm.effect.vibe"
import * as Ledger from "../../gen/app__billing__ledger.effect.vibe"
import * as Operators from "../../gen/app__admin__operators.effect.vibe"
import * as Referrals from "../../gen/app__admin__referrals.effect.vibe"
import { machineApi } from "../machines.vibe"
import { stateStore } from "../serve.vibe"
import { authenticatedWallet } from "./session.vibe"

const noStore = { "cache-control": "no-store" }

export error BadJson { raw: string }

interface SenderMachine {
  get(): unknown!!
  receive(input: unknown, by: string): any!any
  changes: Stream.Stream<unknown>
}

function projectReferrals(state: { codes?: { owner: string; code: string }[]; signups?: { wallet: string; code: string }[] }, wallet: string) {
  const codes = (state.codes ?? []).filter((row) => row.owner == wallet)
  const mine = new Set(codes.map((row) => row.code))
  return { codes, signups: (state.signups ?? []).filter((row) => row.wallet == wallet || mine.has(row.code)) }
}

function projectCrm(state: { profiles?: { wallet: string }[] }, wallet: string) {
  return {
    profiles: (state.profiles ?? []).filter((row) => row.wallet == wallet),
    activities: [], tasks: [], flags: [], segments: [], adjustments: [],
  }
}

effect function getScopedState(admin: Admin.Machine.Shape, m: SenderMachine, project: (state: any, wallet: string) => unknown) {
  const wallet = try authenticatedWallet()
  if (wallet == "") return try HttpServerResponse.json({ error: "sign in required" }, { status: 401, headers: noStore })
  const state = try m.get()
  const operator = try operatorRequired(admin)
  return try HttpServerResponse.json(operator != "" ? state : project(state, wallet), { headers: noStore })
}

effect function getScopedStream(admin: Admin.Machine.Shape, m: SenderMachine, project: (state: any, wallet: string) => unknown) {
  const wallet = try authenticatedWallet()
  if (wallet == "") return try HttpServerResponse.json({ error: "sign in required" }, { status: 401, headers: noStore })
  const operator = try operatorRequired(admin)
  const full = operator != ""
  const pushes = Stream.map(m.changes, (raw) => `data: ${JSON.stringify(full ? raw : project(raw, wallet))}\n\n`)
  return HttpServerResponse.stream(Stream.encodeText(pushes), {
    contentType: "text/event-stream",
    headers: noStore,
  })
}

effect function getState(admin: Admin.Machine.Shape, m: SenderMachine) {
  const operator = try operatorRequired(admin)
  if (operator == "") return try HttpServerResponse.json({ error: "operator access required" }, { status: 403, headers: noStore })
  return try HttpServerResponse.json(try m.get(), { headers: noStore })
}

// The machine's POST derives the trusted sender from the verified session — never from anything
// the client supplied. Metering events like accrueUsage are internal and never cross HTTP.
const adminUserEvents = ["grant", "revoke", "suspend", "reinstate", "register"]

/** The session wallet's operator role as the directory holds it: "admin", "support" or "finance",
 * and "" when the wallet is signed out or a customer. The capability matrix every privileged
 * endpoint checks: moderation and roster changes are the Admin role's, treasury and adjustments
 * the Finance role's, the support queue the Support role's. */
export effect function operatorRole(admin: Admin.Machine.Shape) {
  const wallet = try authenticatedWallet()
  if (wallet == "") return ""
  const registry = try admin.get()
  const role = Operators.roleOf(registry.ops, wallet)
  return role == "member" ? "" : role
}

/** The session wallet when it holds one of the named roles, else the empty string. */
export effect function operatorWithRoles(admin: Admin.Machine.Shape, roles: readonly string[]) {
  const wallet = try authenticatedWallet()
  if (wallet == "") return ""
  const registry = try admin.get()
  return roles.includes(Operators.roleOf(registry.ops, wallet)) ? wallet : ""
}

/** The session wallet is a listed operator, or the empty roster's bootstrap still holds. */
export effect function operatorRequired(admin: Admin.Machine.Shape) {
  const operator = try authenticatedWallet()
  if (operator == "") return ""
  const registry = try admin.get()
  if (!registry.ops.roster.some((o) => o.wallet == operator)) return ""
  return operator
}

// Granting, revoking and moderating are the Admin role's alone: a support or finance operator
// cannot self-grant admin or suspend an account. The one exception is the machine's own bootstrap:
// an empty roster appoints the first operator from whoever asks, and only a grant may be sent then.
// Answers carry the registry only to a listed operator; a refusal never carries state at all.
effect function postSender(m: SenderMachine) {
  const request = try HttpServerRequest.HttpServerRequest
  if (!request.headers["content-type"]?.startsWith("application/json")) {
    return try HttpServerResponse.json({ error: "send application/json" }, { status: 415, headers: noStore })
  }
  const operator = try authenticatedWallet()
  if (operator == "") return try HttpServerResponse.json({ ok: false, error: "sign in required" }, { status: 401, headers: noStore })
  const input = (request.json catch () => undefined) as { type?: unknown } | undefined
  if (input == undefined || typeof input.type != "string" || !adminUserEvents.includes(input.type as string)) {
    return try HttpServerResponse.json({ ok: false, error: "This event is not yours to send." }, { status: 403, headers: noStore })
  }
  const registry = (try m.get()) as Admin.Registry
  const role = Operators.roleOf(registry.ops, operator)
  const bootstrap = registry.ops.roster.length == 0 && input.type == "grant"
  if (role != "admin" && !bootstrap) {
    return try HttpServerResponse.json({ ok: false, error: "administrator access required" }, { status: 403, headers: noStore })
  }
  const sender = Admin.decodeSender(operator) catch () => undefined
  if (sender === undefined) {
    return try HttpServerResponse.json({ ok: false, error: "NotASender" }, { status: 400, headers: noStore })
  }
  const sent = m.receive(input, sender) catch (error) => error
  const rejected = sent as { _tag?: string }
  if (rejected && typeof rejected === "object" && "_tag" in rejected) {
    const status = rejected._tag === "NotAnEvent" ? 400 : rejected._tag === "Rejected" ? 409 : 500
    return try HttpServerResponse.json({ ok: false, error: rejected._tag }, { status, headers: noStore })
  }
  const listed = Operators.roleOf((sent as Admin.Registry).ops, operator) != "member"
  return try HttpServerResponse.json(listed ? { ok: true, state: sent } : { ok: true }, { headers: noStore })
}

// Operator-only machines (CRM, referrals): a customer's own events — issuing an invite code,
// signing up through one, saving one's own profile — bind their identity fields to the session
// and answer with the wallet's projected rows. Every other write is the Admin role's alone, and a
// refusal never carries state: the raw machine holds every customer's rows.
effect function postOperatorEvent(admin: Admin.Machine.Shape, m: SenderMachine, project: (state: any, wallet: string) => unknown) {
  const request = try HttpServerRequest.HttpServerRequest
  if (!request.headers["content-type"]?.startsWith("application/json")) {
    return try HttpServerResponse.json({ error: "send application/json" }, { status: 415, headers: noStore })
  }
  const wallet = try authenticatedWallet()
  if (wallet == "") return try HttpServerResponse.json({ ok: false, error: "sign in required" }, { status: 401, headers: noStore })
  const operator = try operatorRequired(admin)
  const input = (request.json catch () => undefined) as { type?: unknown; wallet?: unknown } | undefined
  const answer = (sent: unknown) => {
    const rejected = sent as { _tag?: string }
    if (rejected && typeof rejected === "object" && "_tag" in rejected) {
      const status = rejected._tag === "NotAnEvent" ? 400 : rejected._tag === "Rejected" ? 409 : 500
      return { body: { ok: false, error: rejected._tag }, status }
    }
    return { body: { ok: true, state: operator != "" ? sent : project(sent, wallet) }, status: 200 }
  }
  if (input != undefined && (input.type == "issueCode" || input.type == "signup")) {
    const own = { ...(input as Record<string, unknown>) } as Record<string, unknown>
    if ("owner" in own) own["owner"] = wallet
    if ("wallet" in own) own["wallet"] = wallet
    const sentUser = m.receive(own, operator != "" ? operator : wallet) catch (error) => error
    const out = answer(sentUser)
    return try HttpServerResponse.json(out.body, { status: out.status, headers: noStore })
  }
  if (input != undefined && input.type == "saveProfile") {
    const own = { ...(input as Record<string, unknown>), wallet }
    const sentOwn = m.receive(own, operator != "" ? operator : wallet) catch (error) => error
    const out = answer(sentOwn)
    return try HttpServerResponse.json(out.body, { status: out.status, headers: noStore })
  }
  const adminOperator = try operatorWithRoles(admin, ["admin"])
  if (adminOperator == "") return try HttpServerResponse.json({ ok: false, error: "administrator access required" }, { status: 403, headers: noStore })
  const sent = m.receive(input, adminOperator) catch (error) => error
  const out = answer(sent)
  return try HttpServerResponse.json(out.body, { status: out.status, headers: noStore })
}

effect function getStream(admin: Admin.Machine.Shape, m: SenderMachine) {
  const operator = try operatorRequired(admin)
  if (operator == "") return try HttpServerResponse.json({ error: "operator access required" }, { status: 403, headers: noStore })
  const pushes = Stream.map(m.changes, (s) => `data: ${JSON.stringify(s)}\n\n`)
  return HttpServerResponse.stream(Stream.encodeText(pushes), {
    contentType: "text/event-stream",
    headers: noStore,
  })
}

/** The shared state the admin views join, held only for a listed operator. */
effect function overview(admin: Admin.Machine.Shape) {
  const operator = try operatorRequired(admin)
  if (operator == "") {
    return try HttpServerResponse.json({ error: "operator access required" }, { status: 403, headers: noStore })
  }
  const kv = try KeyValueStore.KeyValueStore
  const states = {} as Record<string, unknown>
  for (const joined of Admin.joinedKeys) {
    const found = kv.get(joined.storage) catch () => undefined
    states[joined.projection] =
      found === undefined
        ? null
        : (Effect.try({ try: () => JSON.parse(found) as unknown, catch: () => new BadJson({ raw: found }) }) catch () => null)
  }
  return try HttpServerResponse.json(states, { headers: noStore })
}

// spec/app/billing/ledger.md, "Story: Adjust a balance": the operator's adjustment moves credit in
// the ledger itself and is recorded in the CRM, both naming the one adjustment record — so the
// audited record and the balance never disagree. The operator is the session wallet, checked
// against the roster; an empty roster is the bootstrap every staging shell starts from.
function adjustmentEntry(state: Ledger.Ledger, detail: string) {
  return state.entries.find((entry) => entry.detail == detail && (entry.kind == "AdjustCredit" || entry.kind == "AdjustDebit"))
}

function entryMatches(entry: Ledger.Entry | undefined, wallet: string, kind: Ledger.EntryKind, amount: number) {
  return entry != undefined && entry.wallet == wallet && entry.kind == kind && entry.amount == amount
}

function balanceBeforeEntry(entries: Ledger.Entry[], wallet: string, detail: string) {
  let balance = 0
  for (const entry of entries) {
    if (entry.detail == detail && (entry.kind == "AdjustCredit" || entry.kind == "AdjustDebit")) return balance
    if (entry.wallet == wallet) balance += Ledger.contribution(entry)
  }
  return balance
}

effect function postAdjust() {
  const request = try HttpServerRequest.HttpServerRequest
  const operator = try authenticatedWallet()
  if (operator == "") return try HttpServerResponse.json({ ok: false, error: "sign in required" }, { status: 401, headers: noStore })
  if (!request.headers["content-type"]?.startsWith("application/json")) {
    return try HttpServerResponse.json({ error: "send application/json" }, { status: 415, headers: noStore })
  }
  const admin = try Admin.Machine
  const registry = try admin.get()
  if (!["finance", "admin"].includes(Operators.roleOf(registry.ops, operator))) {
    return try HttpServerResponse.json({ ok: false, error: "finance or administrator access required" }, { status: 403, headers: noStore })
  }
  const raw = request.json catch () => undefined
  const input = raw as { id?: unknown; activityId?: unknown; account?: unknown; delta?: unknown; reason?: unknown } | undefined
  const id = typeof input?.id == "string" ? input.id : ""
  const activityId = typeof input?.activityId == "string" ? input.activityId : ""
  const account = typeof input?.account == "string" ? input.account : ""
  const delta = typeof input?.delta == "number" && Number.isSafeInteger(input.delta) ? input.delta : 0
  const reason = typeof input?.reason == "string" ? input.reason.trim() : ""
  if (id == "" || activityId == "" || account == "") {
    return try HttpServerResponse.json({ ok: false, error: "An adjustment id, activity id and account are required." }, { status: 400, headers: noStore })
  }
  if (delta == 0 || Math.abs(delta) > 1_000_000_000) {
    return try HttpServerResponse.json({ ok: false, error: "Adjust by a whole credit amount within 1,000 USD." }, { status: 400, headers: noStore })
  }
  if (reason.length < 8 || reason.length > 500) {
    return try HttpServerResponse.json({ ok: false, error: "Record an evidence note of 8 to 500 characters." }, { status: 400, headers: noStore })
  }
  const amount = Math.abs(delta)
  const kind = delta > 0 ? "AdjustCredit" : "AdjustDebit"
  const ledger = try Ledger.Machine
  const before = try ledger.get()
  const crm = try Crm.Machine
  const crmBefore = try crm.get()
  const written = adjustmentEntry(before, id)
  const writtenMatches = entryMatches(written, account, kind, amount)
  if (written != undefined && !writtenMatches) {
    return try HttpServerResponse.json({ ok: false, error: "This adjustment id names a different ledger entry." }, { status: 409, headers: noStore })
  }
  const record = crmBefore.adjustments.find((row) => row.id == id)
  const recordMatches = record != undefined && record.account == account && record.admin == operator && record.delta == delta && record.reason == reason
  if (record != undefined && !recordMatches) {
    return try HttpServerResponse.json({ ok: false, error: "This adjustment id names a different audited record." }, { status: 409, headers: noStore })
  }
  const activity = crmBefore.activities.find((row) => row.id == activityId)
  const activityMatches = activity != undefined && activity.account == account && activity.actor == operator && activity.kind == "adjust"
  if (recordMatches && activityMatches) {
    if (writtenMatches) return try HttpServerResponse.json({ ok: true, balanceAfter: record.balanceAfter }, { headers: noStore })
    return try HttpServerResponse.json({ ok: false, error: "The audited record exists without its ledger entry." }, { status: 500, headers: noStore })
  }
  if (record != undefined || activity != undefined) {
    return try HttpServerResponse.json({ ok: false, error: "This adjustment or activity id is already used in the customer timeline." }, { status: 409, headers: noStore })
  }
  const balanceBefore = writtenMatches ? balanceBeforeEntry(before.entries, account, id) : Ledger.balanceOf(before, account)
  if (!writtenMatches && balanceBefore + delta < 0) {
    return try HttpServerResponse.json({ ok: false, error: "This adjustment would overdraw the account balance." }, { status: 409, headers: noStore })
  }
  const now = try Clock.currentTimeMillis
  const summary = "Balance adjusted by operations: " + reason.slice(0, 120)
  if (!Crm.canRecordAdjustment(crmBefore, id, activityId, account, operator, delta, reason, balanceBefore, summary, now)) {
    return try HttpServerResponse.json({ ok: false, error: "The adjustment record was refused." }, { status: 409, headers: noStore })
  }
  if (!writtenMatches) {
    const movement = delta > 0
      ? ledger.send({ type: "adjustCredit", wallet: account, detail: id, amount }) catch (e) => e
      : ledger.send({ type: "adjustDebit", wallet: account, detail: id, amount }) catch (e) => e
    if (movement instanceof Ledger.Rejected) {
      const current = try ledger.get()
      if (!entryMatches(adjustmentEntry(current, id), account, kind, amount)) {
        return try HttpServerResponse.json({ ok: false, error: "The ledger refused the adjustment." }, { status: 409, headers: noStore })
      }
    }
  }
  const recorded = crm.send({ type: "recordAdjustment", id, activityId, account, admin: operator, delta, reason, balanceBefore, summary, now }) catch (e) => e
  if (recorded instanceof Crm.Rejected) {
    const current = try crm.get()
    const completed = current.adjustments.some((row) => row.id == id && row.account == account && row.admin == operator && row.delta == delta && row.reason == reason) &&
      current.activities.some((row) => row.id == activityId && row.account == account && row.kind == "adjust")
    if (!completed) {
      return try HttpServerResponse.json({ ok: false, error: "The ledger moved the credit but the record was refused." }, { status: 500, headers: noStore })
    }
  }
  return try HttpServerResponse.json({ ok: true, balanceAfter: balanceBefore + delta }, { headers: noStore })
}

// spec/app/admin/operators.md, "Only an operator can grant access": deployment
// configuration names the first operators so a fresh or reset store still opens to the people
// who run the surface. The machine's own rule validates every grant — this only asks.
// SONNELY_ADMIN_WALLETS, SONNELY_SUPPORT_WALLETS and SONNELY_FINANCE_WALLETS list the
// comma-separated wallets for each role; SONNELY_OPERATORS names further Admin wallets.
// The first listed wallet sends every grant: the empty roster appoints it, and its own
// membership authorises the rest.
function seededWallets(seed: string) {
  return seed.split(",").map((w) => w.trim()).filter((w) => w != "")
}

effect function seededGrants() {
  const admins = Config.withDefault(Config.String("SONNELY_ADMIN_WALLETS"), "") catch () => ""
  const legacy = Config.withDefault(Config.String("SONNELY_OPERATORS"), "") catch () => ""
  const support = Config.withDefault(Config.String("SONNELY_SUPPORT_WALLETS"), "") catch () => ""
  const finance = Config.withDefault(Config.String("SONNELY_FINANCE_WALLETS"), "") catch () => ""
  const grants = [
    ...seededWallets(admins + "," + legacy).map((wallet) => ({ wallet, role: "Admin" })),
    ...seededWallets(support).map((wallet) => ({ wallet, role: "Support" })),
    ...seededWallets(finance).map((wallet) => ({ wallet, role: "Finance" })),
  ]
  const seen: string[] = []
  return grants.filter((grant) => {
    if (seen.includes(grant.wallet)) return false
    seen.push(grant.wallet)
    return true
  })
}

effect function bootstrapOperators(admin: Admin.Machine.Shape) {
  const grants = try seededGrants()
  if (grants.length == 0) return
  const registry = try admin.get()
  if (registry.ops.roster.length > 0) return
  const first = grants[0]
  if (first == undefined) return
  const sender = Admin.decodeSender(first.wallet) catch () => undefined
  if (sender === undefined) return
  const now = try Clock.currentTimeMillis
  for (const grant of grants) {
    admin.receive({ type: "grant", wallet: grant.wallet, role: grant.role, at: now }, sender) catch () => undefined
  }
}

export const adminApi = Layer.unwrap(effect {
  const admin = try Admin.Machine
  const crm = try Crm.Machine
  const referrals = try Referrals.Machine
  try bootstrapOperators(admin)
  return Layer.mergeAll(
    HttpRouter.add("POST", "/api/admin/adjust", provideService(postAdjust(), HttpServerRequest.MaxBodySize, ByteSize.kibibytes(16))),
    HttpRouter.add("GET", "/api/machines/admin", getState(admin, admin)),
    HttpRouter.add("POST", "/api/machines/admin", provideService(postSender(admin), HttpServerRequest.MaxBodySize, ByteSize.kibibytes(256))),
    HttpRouter.add("GET", "/api/machines/admin/stream", getStream(admin, admin)),
    HttpRouter.add("GET", "/api/admin/overview", overview(admin)),
    HttpRouter.add("GET", "/api/machines/admin-crm", getScopedState(admin, crm, projectCrm)),
    HttpRouter.add("POST", "/api/machines/admin-crm", provideService(postOperatorEvent(admin, crm, projectCrm), HttpServerRequest.MaxBodySize, ByteSize.kibibytes(256))),
    HttpRouter.add("GET", "/api/machines/admin-crm/stream", getScopedStream(admin, crm, projectCrm)),
    HttpRouter.add("GET", "/api/machines/admin-referrals", getScopedState(admin, referrals, projectReferrals)),
    HttpRouter.add("POST", "/api/machines/admin-referrals", provideService(postOperatorEvent(admin, referrals, projectReferrals), HttpServerRequest.MaxBodySize, ByteSize.kibibytes(256))),
    HttpRouter.add("GET", "/api/machines/admin-referrals/stream", getScopedStream(admin, referrals, projectReferrals)),
  )
})

export function adminState(dir: string) {
  return Layer.mergeAll(
    Layer.provide(Admin.stored("admin"), stateStore(dir)),
    Layer.provide(Crm.stored("admin-crm"), stateStore(dir)),
    Layer.provide(Referrals.stored("admin-referrals"), stateStore(dir)),
  )
}

/** The admin machine kept in the shared store under `admin`. */
export const admin = Admin.stored("admin")

/** The referrals machine kept in the shared store under `admin-referrals`. */
export const referrals = Referrals.stored("admin-referrals")

/** An event for the admin machine from anywhere untrusted, decoded before the rules see it. */
export effect function dispatch(input: unknown, by: unknown) {
  const machine = try Admin.Machine
  return try machine.receive(input, try Admin.decodeSender(by))
}

/** An event for the referrals machine from anywhere untrusted. */
export effect function dispatchReferral(input: unknown) {
  const machine = try Referrals.Machine
  return try machine.receive(input)
}
