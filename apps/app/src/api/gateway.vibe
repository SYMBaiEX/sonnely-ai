// spec/app/gateway/index.md — the staging gateway: bearer-key authorization against the workspace
// keys, metered reservations on the billing ledger, project and key budgets, the usage meter, the
// served-request ledger under "gateway-requests" and the per-wallet batch job under "gateway-batch:<wallet>".
// There is no upstream provider here: each endpoint answers a deterministic completion in the OpenAI
// wire shape after the machines rule on the request.
import * as Keyring from "../../gen/app__gateway__keyring.effect.vibe"
import * as Requests from "../../gen/app__gateway__requests.effect.vibe"
import * as Batch from "../../gen/app__gateway__batch.effect.vibe"
import * as WorkspaceKeys from "../../gen/app__keys.effect.vibe"
import * as Ledger from "../../gen/app__billing__ledger.effect.vibe"
import * as Usage from "../../gen/app__usage.effect.vibe"
import * as Teams from "../../gen/app__teams.effect.vibe"
import * as Admin from "../../gen/app__admin.effect.vibe"
import * as Referrals from "../../gen/app__admin__referrals.effect.vibe"
import { authenticatedWallet } from "./session.vibe"
import { Fleet } from "../fleet.vibe"
import { stateStore } from "../serve.vibe"
import { type StreamFinal, cachedTokens, callChatCandidates, callSpecialized, settleUsageCost, sliceTopResults, multipartForm, multipartInput, validateMultipart, parseSpecialized, specializedInputTokens, specializedRoute, chatSseNodeResponse, configuredProviders, stagingInference, keyStatusPayload, idempotentRef, validIdempotencyKey, modelsPayload, parseChatCompletion, parseChatInput, nearEvidence, phalaEvidence, providerModelsPayload, providerRequestReference, publicUsage, selectChat, sha256, tokenCharge } from "./gateway/providers.ts"

module node {
  import { createHash, randomUUID } from "node:crypto"
  /** The workspace key hash a bearer token resolves to: the record never holds the token itself. */
  export function hashToken(token: string) {
    return createHash("sha256").update(token).digest("hex")
  }
  /** A fresh request reference. */
  export function newRef() {
    return randomUUID()
  }
}
import { hashToken, newRef } from node

export { newRef }

const noStore = { "cache-control": "no-store" }

effect function reply(value: unknown, status: number = 200) {
  return try HttpServerResponse.json(value, { status, headers: noStore })
}

/** An error in the OpenAI shape. */
effect function oops(message: string, status: number, type: string = "invalid_request_error") {
  return try reply({ error: { message, type, param: null, code: null } }, status)
}

/** A meter or authorization refusal in the OpenAI shape, carrying the request reference when there is one. */
effect function refusalReply(refused: { error: unknown; status: number }, ref: string) {
  const inner = refused.error as { message: string; type: string }
  const response = try reply({ error: { message: inner.message, type: inner.type, param: null, code: null } }, refused.status)
  if (ref == "") return response
  return HttpServerResponse.setHeaders(response, { "X-Sonnely-Request-Id": ref })
}

/** The id the bearer token resolves to, or "" when none was sent. */
function bearerId(request: { headers: Record<string, string | undefined> }): string {
  const auth = request.headers["authorization"] ?? ""
  return auth.startsWith("Bearer ") ? hashToken(auth.slice(7)) : ""
}

// spec/app/admin/index.md, "Only an active account can be suspended": suspension stops inference
// for the account, whichever credential the request arrives on.
effect function suspendedAccount(wallet: string) {
  if (wallet == "") return false
  const admin = try Admin.Machine
  const registry = try admin.get()
  return registry.records.some((record) => record.id == wallet && record.status == "Suspended")
}

/** The key the request's bearer names, or the refusal in the OpenAI shape. */
export effect function bearerKey() {
  const request = try HttpServerRequest.HttpServerRequest
  const id = bearerId(request)
  if (id == "") return { refused: { error: { message: "A valid bearer key is required.", type: "invalid_request_error" }, status: 401 } }
  const keys = try WorkspaceKeys.Machine
  const state = try keys.get()
  const key = state.keys.find((k) => k.hash == id)
  if (key == undefined || key.status != "Active") {
    return { refused: { error: { message: "The key is missing or revoked.", type: "invalid_request_error" }, status: 401 } }
  }
  const now = try Clock.currentTimeMillis
  if (key.expiresAt != 0 && key.expiresAt <= now) {
    return { refused: { error: { message: "The key has expired.", type: "invalid_request_error" }, status: 401 } }
  }
  if (!key.scopes.includes("inference")) {
    return { refused: { error: { message: "The key cannot use inference.", type: "insufficient_quota" }, status: 402 } }
  }
  if (try suspendedAccount(key.wallet)) {
    return { refused: { error: { message: "This account's inference access is suspended.", type: "invalid_request_error" }, status: 403 } }
  }
  return { key }
}

effect function authorized(endpoint: Requests.Endpoint, model: string) {
  const auth = try bearerKey()
  if ("refused" in auth) return auth
  if (!Requests.registered(endpoint, model)) {
    return { refused: { error: { message: "Choose a model from the catalog.", type: "invalid_request_error" }, status: 404 } }
  }
  return auth
}

/** What one deterministic answer costs: one micro-USD per hundred input bytes, at least one. */
function stagedCost(bytes: number): number {
  return Math.max(1, Math.ceil(bytes / 100))
}

/**
 * Record the served request and its charge: reserve the wallet's credits, hold project and key budget,
 * write the pending usage row, open the served-request ledger, then settle the hold and usage exactly
 * once. Every refusal before completion releases what the reservation took.
 */
function providerOfModel(model: string): Usage.Provider {
  if (model.startsWith("phala/")) return "Phala"
  if (model.startsWith("tinfoil/")) return "Tinfoil"
  return "NearAI"
}

effect function unwindMeter(ref: string, wallet: string, key: WorkspaceKeys.Key | undefined, cost: number, day: string, projectHeld: boolean, keyHeld: boolean, usageRecorded: boolean, opened: boolean) {
  if (key != undefined && keyHeld) {
    const keys = try WorkspaceKeys.Machine
    keys.send({ type: "refundUse", id: key.id, amount: cost, day }, wallet) catch () => undefined
  }
  if (key != undefined && projectHeld) {
    const teams = try Teams.Machine
    teams.send({ type: "releaseProject", projectId: key.project, amount: cost }) catch () => undefined
  }
  const ledger = try Ledger.Machine
  ledger.send({ type: "release", wallet, detail: ref }) catch () => undefined
  if (opened) {
    const requests = try Requests.Machine
    requests.send({ type: "fault", ref }) catch () => undefined
  }
  if (usageRecorded) {
    const usage = try Usage.Machine
    usage.send({ type: "release", id: ref }, wallet) catch () => undefined
  }
}

export interface MeterOpen {
  ref: string
  wallet: string
  key: WorkspaceKeys.Key | undefined
  day: string
  reserve: number
  endpoint: Requests.Endpoint
  model: string
  stream: boolean
  startedAt: number
}

export function servedKey(key: WorkspaceKeys.Key | undefined, wallet: string): Keyring.KeyRecord {
  if (key != undefined) return { id: key.hash, prefix: key.prefix, status: key.status, spendLimit: key.cap == 0 ? -1 : key.cap, spent: key.spent }
  return { id: "session:" + wallet, prefix: "console", status: "Active", spendLimit: -1, spent: 0 }
}

function meterProvider(provider: string): Usage.Provider {
  if (provider == "phala") return "Phala"
  if (provider == "tinfoil") return "Tinfoil"
  return "NearAI"
}

export effect function openMeter(ref: string, wallet: string, key: WorkspaceKeys.Key | undefined, endpoint: Requests.Endpoint, model: string, stream: boolean, cost: number, providerOverride: Usage.Provider | undefined = undefined) {
  const now = try Clock.currentTimeMillis
  const day = new Date(now).toISOString().slice(0, 10)
  const keys = try WorkspaceKeys.Machine
  if (key != undefined && !WorkspaceKeys.canRecordUse(try keys.get(), wallet, key.id, cost, day, now)) {
    return { refused: { error: { message: "The API key budget would be exceeded.", type: "insufficient_quota" }, status: 402 } }
  }
  const teams = try Teams.Machine
  if (key != undefined && key.project != "" && !Teams.canHoldProject(try teams.get(), key.project, cost)) {
    return { refused: { error: { message: "The project budget would be exceeded.", type: "insufficient_quota" }, status: 402 } }
  }
  const requestLedger = try Requests.Machine
  if ((try requestLedger.get()).requests.some((served) => served.ref == ref)) {
    return { refused: { error: { message: "A request with this reference is already open.", type: "invalid_request_error" }, status: 409 } }
  }
  const ledger = try Ledger.Machine
  if (!Ledger.canReserve(try ledger.get(), wallet, ref, cost)) {
    return { refused: { error: { message: "Insufficient compute credits.", type: "insufficient_quota" }, status: 402 } }
  }
  const reserved = ledger.send({ type: "reserve", wallet, detail: ref, amount: cost }) catch (e) => e
  if (reserved instanceof Ledger.Rejected) {
    return { refused: { error: { message: "Insufficient compute credits.", type: "insufficient_quota" }, status: 402 } }
  }
  let projectHeld = false
  let keyHeld = false
  if (key != undefined && key.project != "") {
    const heldProject = teams.send({ type: "holdProject", projectId: key.project, amount: cost }) catch (e) => e
    if (heldProject instanceof Teams.Rejected) {
      ledger.send({ type: "release", wallet, detail: ref }) catch () => undefined
      return { refused: { error: { message: "The project budget would be exceeded.", type: "insufficient_quota" }, status: 402 } }
    }
    projectHeld = true
  }
  if (key != undefined) {
    const used = keys.send({ type: "recordUse", id: key.id, cost, day, now }, wallet) catch (e) => e
    if (used instanceof WorkspaceKeys.Rejected) {
      try unwindMeter(ref, wallet, key, cost, day, projectHeld, false, false, false)
      return { refused: { error: { message: "The API key budget would be exceeded.", type: "insufficient_quota" }, status: 402 } }
    }
    keyHeld = true
  }
  const usage = try Usage.Machine
  const row = usage.send({
    type: "record",
    id: ref,
    time: now,
    keyName: key?.label ?? "Console",
    keyId: key?.id ?? "",
    project: key?.project ?? "",
    model,
    provider: providerOverride ?? providerOfModel(model),
    cost,
  }, wallet) catch (e) => e
  if (row instanceof Usage.Rejected) {
    try unwindMeter(ref, wallet, key, cost, day, projectHeld, keyHeld, false, false)
    return { refused: { error: { message: "The request could not be metered.", type: "server_error" }, status: 500 } }
  }
  const requests = try Requests.Machine
  const openedRequest = requests.send({ type: "open", ref, key: servedKey(key, wallet), endpoint, model, stream }) catch (e) => e
  if (openedRequest instanceof Requests.Rejected) {
    try unwindMeter(ref, wallet, key, cost, day, projectHeld, keyHeld, true, false)
    return { refused: { error: { message: "A request with this reference is already open.", type: "invalid_request_error" }, status: 409 } }
  }
  return { meter: { ref, wallet, key, day, reserve: cost, endpoint, model, stream, startedAt: now } }
}

effect function markReferralActive(referrals: Referrals.Machine.Shape, wallet: string, charge: number) {
  if (charge <= 0) return
  referrals.send({ type: "markActive", wallet }) catch () => undefined
}

export effect function settleMeter(meter: MeterOpen, input: number, output: number, cached: number, cost: number, providerMs: number) {
  const charge = Math.min(meter.reserve, Math.max(0, cost))
  const refund = meter.reserve - charge
  const usage = try Usage.Machine
  const row = (try usage.get()).rows.find((r) => r.id == meter.ref)
  if (row == undefined) {
    return { refused: { error: { message: "The charge could not be recorded.", type: "insufficient_quota" }, status: 402 } }
  }
  if (row.status != "Pending") {
    // spec/app/usage.md, "Rows are never removed and settled rows never change": the usage row is the
    // settlement saga's commit point — it closes only after every compensation is durably sent, so a
    // repeated settlement of a closed row is a no-op and no compensation can be applied twice.
    if (row.status == "Complete") return { served: true, charged: row.cost }
    return { refused: { error: { message: "The charge could not be recorded.", type: "insufficient_quota" }, status: 402 } }
  }
  const ledger = try Ledger.Machine
  const settledMoney = ledger.send({ type: "settleHold", wallet: meter.wallet, detail: meter.ref, amount: charge }) catch (e) => e
  if (settledMoney instanceof Ledger.Rejected) return { refused: { error: { message: "The charge could not be recorded.", type: "insufficient_quota" }, status: 402 } }
  if (meter.key != undefined && refund > 0) {
    const keys = try WorkspaceKeys.Machine
    keys.send({ type: "refundUse", id: meter.key.id, amount: refund, day: meter.day }, meter.wallet) catch () => undefined
    if (meter.key.project != "") {
      const teams = try Teams.Machine
      teams.send({ type: "releaseProject", projectId: meter.key.project, amount: refund }) catch () => undefined
    }
  }
  const referrals = try Referrals.Machine
  try markReferralActive(referrals, meter.wallet, charge)
  const requests = try Requests.Machine
  if (meter.stream && output > 0) requests.send({ type: "emit", ref: meter.ref, tokens: output }) catch () => undefined
  const finished = requests.send({ type: "finish", ref: meter.ref, cost: charge }) catch (e) => e
  const chargedUse = usage.send({ type: "charge", id: meter.ref, input, output, cached, cost: charge, providerMs }, meter.wallet) catch (e) => e
  if (chargedUse instanceof Usage.Rejected || finished instanceof Requests.Rejected) {
    return { refused: { error: { message: "The charge could not be recorded.", type: "insufficient_quota" }, status: 402 } }
  }
  return { served: true, charged: charge }
}

// spec/app/usage.md, "A pending request can fail or go under review": the usage row closes last, after
// the money step and every compensation, so a row still pending always means the saga is incomplete
// and the reconciliation sweep can finish it.
export effect function failMeter(meter: MeterOpen, unreported: boolean) {
  const ledger = try Ledger.Machine
  const usage = try Usage.Machine
  const requests = try Requests.Machine
  if (unreported) {
    ledger.send({ type: "settleHold", wallet: meter.wallet, detail: meter.ref, amount: meter.reserve }) catch () => undefined
    requests.send({ type: "finish", ref: meter.ref, cost: meter.reserve }) catch () => undefined
    usage.send({ type: "unreported", id: meter.ref, input: 0, output: 0, cost: meter.reserve }, meter.wallet) catch () => undefined
  } else {
    ledger.send({ type: "settleHold", wallet: meter.wallet, detail: meter.ref, amount: 0 }) catch () => undefined
    if (meter.key != undefined) {
      const keys = try WorkspaceKeys.Machine
      keys.send({ type: "refundUse", id: meter.key.id, amount: meter.reserve, day: meter.day }, meter.wallet) catch () => undefined
      if (meter.key.project != "") {
        const teams = try Teams.Machine
        teams.send({ type: "releaseProject", projectId: meter.key.project, amount: meter.reserve }) catch () => undefined
      }
    }
    requests.send({ type: "fault", ref: meter.ref }) catch () => undefined
    usage.send({ type: "release", id: meter.ref }, meter.wallet) catch () => undefined
  }
}

effect function stageMeter(ref: string, key: WorkspaceKeys.Key, endpoint: Requests.Endpoint, model: string, stream: boolean, emits: number[], cost: number) {
  const opened = try openMeter(ref, key.wallet, key, endpoint, model, stream, cost)
  if ("refused" in opened) return opened
  for (const tokens of emits) {
    const requests = try Requests.Machine
    requests.send({ type: "emit", ref, tokens }) catch () => undefined
  }
  return try settleMeter(opened.meter, 0, endpoint == "ChatCompletions" ? (stream ? emits.reduce((n, t) => n + t, 0) : 8) : 0, -1, cost, -1)
}

effect function inferenceFailure(message: string, status: number, ref: string) {
  const response = try oops(message, status, "sonnely_error")
  return HttpServerResponse.setHeaders(response, { "X-Sonnely-Request-Id": ref })
}

effect function receiptFor(input: unknown, candidate: unknown, completionId: string, reportedModel: string | undefined, requestBody: string, responseHash: string, charged: number, cached: number, providerReference: string | undefined, tinfoilEvidence: unknown) {
  const requestHash = try Effect.try(() => sha256(requestBody))
  const selected = candidate as { provider: "near-ai" | "phala" | "tinfoil"; key: string; upstreamModel: string }
  const requested = input as { model: string }
  let evidence: unknown = tinfoilEvidence ?? { status: "unavailable" }
  if (selected.provider == "near-ai") {
    evidence = tryPromise(() => nearEvidence(completionId, selected.key, selected.upstreamModel, requestHash, responseHash)) catch () => ({ status: "unavailable" })
  }
  if (selected.provider == "phala") {
    evidence = tryPromise(() => phalaEvidence(providerReference, selected.key, completionId, selected.upstreamModel, requestHash, responseHash)) catch () => ({ status: "unavailable" })
  }
  return {
    version: "v1",
    provider: selected.provider,
    requested_model: requested.model,
    ...(reportedModel == undefined ? {} : { reported_model: reportedModel }),
    provider_completion_id: completionId,
    ...(providerReference == undefined ? {} : { billing_reference: providerReference }),
    charged_microusd: charged,
    cached_input_tokens: cached,
    upstream_request_sha256: requestHash,
    upstream_response_sha256: responseHash,
    evidence,
  }
}

export effect function inferChat(raw: unknown, key: WorkspaceKeys.Key | undefined, wallet: string, ref: string, withReceipt: boolean = false) {
  if (key == undefined && wallet != "" && try suspendedAccount(wallet)) return try inferenceFailure("This account's inference access is suspended.", 403, ref)
  const parsedResult = try Effect.try(() => parseChatInput(raw))
  if (!parsedResult.ok) return try inferenceFailure(parsedResult.message, parsedResult.status, ref)
  const usageBefore = try Usage.Machine
  if ((try usageBefore.get()).rows.some((row) => row.id == ref)) {
    return try inferenceFailure("This Idempotency-Key already started a request. Look up the reference in Request logs.", 409, ref)
  }
  const liveProviders = try Effect.try(() => configuredProviders())
  if (liveProviders.length == 0 && try Effect.try(() => stagingInference())) {
    const input = parsedResult.value
    const cost = stagedCost(JSON.stringify(raw ?? {}).length)
    const openedStage = try openMeter(ref, wallet, key, "ChatCompletions", input.model, input.stream === true, cost)
    if ("refused" in openedStage) {
      const r = openedStage.refused as { error: unknown; status: number }
      return try refusalReply(r, ref)
    }
    const settledStage = try settleMeter(openedStage.meter, 0, 8, -1, cost, -1)
    if ("refused" in settledStage) {
      const r = settledStage.refused as { error: unknown; status: number }
      return try refusalReply(r, ref)
    }
    if (input.stream !== true) {
      const stagedResponse = try reply(completionShape(ref, input.model, cost))
      return HttpServerResponse.setHeaders(stagedResponse, { "X-Sonnely-Request-Id": ref, "X-Sonnely-Provider": "staging" })
    }
    const stagedChunks = Stream.fromIterable([
      `data: ${JSON.stringify(completionChunk(ref, input.model, { role: "assistant" }, null))}\n\n`,
      `data: ${JSON.stringify(completionChunk(ref, input.model, { content: staged }, null))}\n\n`,
      `data: ${JSON.stringify(completionChunk(ref, input.model, {}, "stop"))}\n\n`,
      "data: [DONE]\n\n",
    ])
    return HttpServerResponse.stream(Stream.encodeText(stagedChunks), {
      contentType: "text/event-stream",
      headers: { ...noStore, "X-Sonnely-Request-Id": ref, "X-Sonnely-Provider": "staging" },
    })
  }
  const selectedResult = try Effect.try(() => selectChat(parsedResult.value))
  if (!selectedResult.ok) return try inferenceFailure(selectedResult.message, selectedResult.status, ref)
  const selection = selectedResult.value
  const firstCandidate = selection.candidates[0]
  if (firstCandidate == undefined) return try inferenceFailure("Managed inference is awaiting provider activation.", 503, ref)
  const reserve = selection.candidates.reduce((max, item) => Math.max(max, item.estimate), 0)
  const opened = try openMeter(ref, wallet, key, "ChatCompletions", selection.input.model, selection.stream, reserve, meterProvider(firstCandidate.provider))
  if ("refused" in opened) {
    const r = opened.refused as { error: unknown; status: number }
    return try refusalReply(r, ref)
  }
  const meter = opened.meter
  const cacheSecret = key?.hash ?? wallet
  const providerAt = try Clock.currentTimeMillis
  const upstream = tryPromise(() => callChatCandidates(selection.input, selection.candidates, cacheSecret)) catch () => undefined
  const providerMs = try Clock.currentTimeMillis - providerAt
  if (upstream == undefined) {
    try failMeter(meter, false)
    return try inferenceFailure("The provider did not respond. Nothing was served, so nothing was charged.", 502, ref)
  }
  const candidate = upstream.candidate
  const requestBody = upstream.body
  const response = upstream.response
  if (!response.ok) {
    try failMeter(meter, false)
    return try inferenceFailure("The provider could not complete this request. Nothing was served, so nothing was charged.", 502, ref)
  }
  if (!selection.stream) {
    const completed = tryPromise(() => parseChatCompletion(response)) catch () => undefined
    if (completed == undefined) {
      try failMeter(meter, false)
      return try inferenceFailure("The provider returned incomplete usage information. Nothing was served, so nothing was charged.", 502, ref)
    }
    const usage = completed.completion.usage
    const cached = try Effect.try(() => cachedTokens(usage))
    const cost = try Effect.try(() => tokenCharge(candidate.rate, usage.prompt_tokens, cached, usage.completion_tokens))
    const providerReference = try Effect.try(() => providerRequestReference(candidate.provider, response, completed.completion.id))
    if (candidate.provider == "phala") {
      const evidence = tryPromise(() => phalaEvidence(providerReference, candidate.key, completed.completion.id, candidate.upstreamModel, sha256(requestBody), completed.responseHash)) catch () => ({ status: "unavailable" })
      if ((evidence as { status?: string }).status != "aci_payload_matched") {
        try failMeter(meter, false)
        return try inferenceFailure("Phala did not return matching evidence for the requested private route.", 502, ref)
      }
    }
    const settled = try settleMeter(meter, usage.prompt_tokens, usage.completion_tokens, cached, cost, providerMs)
    if ("refused" in settled) {
      const r = settled.refused as { error: unknown; status: number }
      return try refusalReply(r, ref)
    }
    const body: Record<string, unknown> = {
      ...completed.completion,
      model: selection.input.model,
      usage: try Effect.try(() => publicUsage(usage)),
      sonnely_request_id: ref,
      sonnely_provider: candidate.provider,
    }
    if (withReceipt) {
      body.sonnely_receipt = try receiptFor(selection.input, candidate, completed.completion.id, undefined, requestBody, completed.responseHash, settled.charged, cached, providerReference, upstream.evidence)
    }
    const answered = try reply(body)
    return HttpServerResponse.setHeaders(answered, { "X-Sonnely-Request-Id": ref, "X-Sonnely-Provider": candidate.provider })
  }
  if (response.body == undefined || !(response.headers.get("content-type") ?? "").startsWith("text/event-stream")) {
    try failMeter(meter, false)
    return try inferenceFailure("The provider did not return a stream. Nothing was served, so nothing was charged.", 502, ref)
  }
  const ledger = try Ledger.Machine
  const usageMachine = try Usage.Machine
  const requestMachine = try Requests.Machine
  const keys = try WorkspaceKeys.Machine
  const teams = try Teams.Machine
  const referrals = try Referrals.Machine
  const rememberId = (_id: string) => undefined
  const settleStream = (final: StreamFinal | undefined, _observedFirstTokenAt: number | undefined, servedOutputChars: number) =>
    runPromise(effect {
      if (final == undefined) {
        if (servedOutputChars == 0) {
          ledger.send({ type: "settleHold", wallet, detail: ref, amount: 0 }) catch () => undefined
          if (key != undefined) {
            keys.send({ type: "refundUse", id: key.id, amount: meter.reserve, day: meter.day }, wallet) catch () => undefined
            if (key.project != "") teams.send({ type: "releaseProject", projectId: key.project, amount: meter.reserve }) catch () => undefined
          }
          requestMachine.send({ type: "fault", ref }) catch () => undefined
          usageMachine.send({ type: "release", id: ref }, wallet) catch () => undefined
          return undefined
        }
        // spec/app/usage.md, "A pending request can fail or go under review": the stream died after
        // serving part of its answer, so the capture is the served part estimated from the characters
        // the client received plus the input the provider processed, never more than the reserve.
        const outputTokens = Math.ceil(servedOutputChars / 4)
        const prorated = try Effect.try(() => tokenCharge(candidate.rate, selection.bytes + 256, 0, outputTokens))
        const cost = Math.min(meter.reserve, prorated)
        const refund = meter.reserve - cost
        const settledMoney = ledger.send({ type: "settleHold", wallet, detail: ref, amount: cost }) catch (e) => e
        if (key != undefined && refund > 0) {
          keys.send({ type: "refundUse", id: key.id, amount: refund, day: meter.day }, wallet) catch () => undefined
          if (key.project != "") teams.send({ type: "releaseProject", projectId: key.project, amount: refund }) catch () => undefined
        }
        if (!(settledMoney instanceof Ledger.Rejected)) try markReferralActive(referrals, wallet, cost)
        requestMachine.send({ type: "finish", ref, cost }) catch () => undefined
        usageMachine.send({ type: "unreported", id: ref, input: selection.bytes + 256, output: outputTokens, cost }, wallet) catch () => undefined
        return undefined
      }
      const cached = try Effect.try(() => cachedTokens(final.usage))
      const cost = try Effect.try(() => tokenCharge(candidate.rate, final.usage.prompt_tokens, cached, final.usage.completion_tokens))
      const charge = Math.min(meter.reserve, cost)
      const refund = meter.reserve - charge
      const settledMoney = ledger.send({ type: "settleHold", wallet, detail: ref, amount: charge }) catch (e) => e
      if (key != undefined && refund > 0) {
        keys.send({ type: "refundUse", id: key.id, amount: refund, day: meter.day }, wallet) catch () => undefined
        if (key.project != "") teams.send({ type: "releaseProject", projectId: key.project, amount: refund }) catch () => undefined
      }
      if (!(settledMoney instanceof Ledger.Rejected)) try markReferralActive(referrals, wallet, charge)
      if (final.usage.completion_tokens > 0) requestMachine.send({ type: "emit", ref, tokens: final.usage.completion_tokens }) catch () => undefined
      requestMachine.send({ type: "finish", ref, cost: charge }) catch () => undefined
      usageMachine.send({ type: "charge", id: ref, input: final.usage.prompt_tokens, output: final.usage.completion_tokens, cached, cost: charge, providerMs }, wallet) catch () => undefined
      if (withReceipt !== true) return undefined
      return try receiptFor(selection.input, candidate, final.id, final.reportedModel, requestBody, final.responseHash, charge, cached, (try Effect.try(() => providerRequestReference(candidate.provider, response, final.id))), upstream.evidence)
    })
  const stream = try Effect.try(() => chatSseNodeResponse({
    upstream: response.body!,
    model: selection.input.model,
    includeUsage: selection.input.stream_options?.include_usage === true,
    rememberId,
    settle: settleStream,
  }))
  return HttpServerResponse.raw(stream.body, { status: 200, contentType: "text/event-stream; charset=utf-8", headers: { ...noStore, "X-Sonnely-Request-Id": ref, "X-Sonnely-Provider": candidate.provider, "x-accel-buffering": "no" } })
}

const chatBody = (input: unknown): { model: string; stream: boolean; bytes: number } => {
  const b = input as { model?: unknown; stream?: unknown } | undefined
  return { model: typeof b?.model == "string" ? b.model : "", stream: b?.stream === true, bytes: JSON.stringify(input ?? {}).length }
}

const staged = "Sonnely staging: this endpoint answers deterministic completions; no provider is upstream."

function completionShape(ref: string, model: string, cost: number) {
  const chunk = { role: "assistant", content: staged, refusal: null }
  return {
    id: `chatcmpl-${ref}`,
    object: "chat.completion",
    created: 0,
    model,
    choices: [{ index: 0, message: chunk, finish_reason: "stop" }],
    usage: { prompt_tokens: 0, completion_tokens: 8, total_tokens: 8 },
    sonnely_request_id: ref,
    sonnely_cost_microusd: cost,
  }
}

function completionChunk(ref: string, model: string, delta: object, finish: string | null) {
  return { id: `chatcmpl-${ref}`, object: "chat.completion.chunk", created: 0, model, choices: [{ index: 0, delta, finish_reason: finish }] }
}

interface ReadMachine {
  get(): unknown!!
  changes: Stream.Stream<unknown>
}

effect function operatorRequired() {
  const wallet = try authenticatedWallet()
  if (wallet == "") return ""
  const admin = try Admin.Machine
  const registry = try admin.get()
  if (!registry.ops.roster.some((o) => o.wallet == wallet)) return ""
  return wallet
}

effect function getState(m: ReadMachine) {
  const operator = try operatorRequired()
  if (operator == "") return try reply({ error: "operator access required" }, 403)
  return try reply(try m.get())
}

effect function getStream(m: ReadMachine) {
  const operator = try operatorRequired()
  if (operator == "") return try reply({ error: "operator access required" }, 403)
  const pushes = Stream.map(m.changes, (s) => `data: ${JSON.stringify(s)}\n\n`)
  return HttpServerResponse.stream(Stream.encodeText(pushes), {
    contentType: "text/event-stream",
    headers: noStore,
  })
}

// spec/app/gateway/requests.md, "Story: Serve a metered completion": a chat completion opens on a live
// key and a registered model, emits only while it streams, then settles exactly one charge.
effect function chatCompletions() {
  const request = try HttpServerRequest.HttpServerRequest
  if (!request.headers["content-type"]?.startsWith("application/json")) return try oops("send application/json", 415)
  const raw = request.json catch () => undefined
  const body = chatBody(raw)
  const auth = try authorized("ChatCompletions", body.model)
  if ("refused" in auth) {
    const r = auth.refused as { error: unknown; status: number }
    return try refusalReply(r, "")
  }
  const idempotency = request.headers["idempotency-key"]
  if (idempotency != undefined && !(try Effect.try(() => validIdempotencyKey(idempotency)))) return try inferenceFailure("Use 8–128 letters, numbers, dots, underscores, colons, or hyphens in Idempotency-Key.", 400, "")
  const ref = idempotency == undefined ? try Effect.try(() => newRef()) : try Effect.try(() => idempotentRef(auth.key.wallet, auth.key.id, idempotency))
  const receipt = request.headers["x-sonnely-receipt"]
  if (receipt != undefined && receipt != "v1") return try inferenceFailure("Unsupported evidence receipt version. Use X-Sonnely-Receipt: v1.", 400, ref)
  const liveProviders = try Effect.try(() => configuredProviders())
  if (liveProviders.length > 0 || !(try Effect.try(() => stagingInference()))) return try inferChat(raw, auth.key, auth.key.wallet, ref, receipt == "v1")
  const cost = stagedCost(body.bytes)
  if (!body.stream) {
    const settled = try stageMeter(ref, auth.key, "ChatCompletions", body.model, false, [], cost)
    if ("refused" in settled) {
      const r = settled.refused as { error: unknown; status: number }
      return try refusalReply(r, ref)
    }
    const response = try reply(completionShape(ref, body.model, cost))
    return HttpServerResponse.setHeaders(response, { "X-Sonnely-Request-Id": ref, "X-Sonnely-Provider": "staging" })
  }
  const emits = [4, 4]
  const settled = try stageMeter(ref, auth.key, "ChatCompletions", body.model, true, emits, cost)
  if ("refused" in settled) {
    const r = settled.refused as { error: unknown; status: number }
    return try refusalReply(r, ref)
  }
  const chunks = Stream.fromIterable([
    `data: ${JSON.stringify(completionChunk(ref, body.model, { role: "assistant" }, null))}\n\n`,
    `data: ${JSON.stringify(completionChunk(ref, body.model, { content: staged }, null))}\n\n`,
    `data: ${JSON.stringify(completionChunk(ref, body.model, {}, "stop"))}\n\n`,
    "data: [DONE]\n\n",
  ])
  return HttpServerResponse.stream(Stream.encodeText(chunks), {
    contentType: "text/event-stream",
    headers: { ...noStore, "X-Sonnely-Request-Id": ref, "X-Sonnely-Provider": "staging" },
  })
}

// spec/app/gateway/index.md — every other v1 endpoint shares the same lifecycle: a live key, a
// registered model, one open and one settled charge; only the wire shape differs.
const endpoints: { path: string; endpoint: Requests.Endpoint; model: (input: unknown) => string; shape: (ref: string, model: string, cost: number) => unknown }[] = [
  { path: "embeddings", endpoint: "Embeddings", model: (i) => (i as any)?.model ?? "", shape: (ref, model) => ({ object: "list", data: [{ object: "embedding", embedding: [0.5, 0.5], index: 0 }], model, usage: { prompt_tokens: 0, total_tokens: 0 }, sonnely_request_id: ref }) },
  { path: "rerank", endpoint: "Rerank", model: (i) => (i as any)?.model ?? "", shape: (ref, model) => ({ object: "list", results: [{ index: 0, relevance_score: 0.5, document: { text: staged } }], model, sonnely_request_id: ref }) },
  { path: "responses", endpoint: "ResponsesApi", model: (i) => (i as any)?.model ?? "", shape: (ref, model) => ({ id: `resp-${ref}`, object: "response", created: 0, model, output: [{ type: "message", role: "assistant", content: [{ type: "output_text", text: staged }] }], status: "completed", sonnely_request_id: ref }) },
  { path: "redact", endpoint: "Redact", model: (i) => (i as any)?.model ?? "pii-filter", shape: (ref) => ({ redacted: staged, sonnely_request_id: ref }) },
  { path: "systemone", endpoint: "Systemone", model: (i) => (i as any)?.model ?? "levanto/sage-2", shape: (ref, model) => ({ id: `sys1-${ref}`, object: "systemone.completion", created: 0, model, output_text: staged, sonnely_request_id: ref }) },
  { path: "images/generations", endpoint: "ImageGenerations", model: (i) => (i as any)?.model ?? "black-forest-labs/FLUX.2-klein-4B", shape: (ref) => ({ created: 0, data: [{ b64_json: "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==" }], sonnely_request_id: ref }) },
  { path: "images/edits", endpoint: "ImageEdits", model: (i) => (i as any)?.model ?? "black-forest-labs/FLUX.2-klein-4B", shape: (ref) => ({ created: 0, data: [{ b64_json: "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==" }], sonnely_request_id: ref }) },
  { path: "audio/speech", endpoint: "AudioSpeech", model: (i) => (i as any)?.model ?? "", shape: (ref) => ({ audio: staged, format: "wav", sonnely_request_id: ref }) },
  { path: "audio/transcriptions", endpoint: "AudioTranscriptions", model: (i) => (i as any)?.model ?? "whisper-large-v3-turbo", shape: (ref) => ({ text: staged, sonnely_request_id: ref }) },
  { path: "audio/translations", endpoint: "AudioTranslations", model: (i) => (i as any)?.model ?? "voxtral-small-24b", shape: (ref) => ({ text: staged, sonnely_request_id: ref }) },
  { path: "convert/file", endpoint: "ConvertFile", model: (i) => (i as any)?.model ?? "doc-upload", shape: (ref) => ({ text: staged, sonnely_request_id: ref }) },
]

export effect function inferSpecialized(path: string, endpoint: Requests.Endpoint, fallbackModel: string, raw: unknown, key: WorkspaceKeys.Key | undefined, wallet: string, ref: string) {
  if (key == undefined && wallet != "" && try suspendedAccount(wallet)) return try inferenceFailure("This account's inference access is suspended.", 403, ref)
  const request = try HttpServerRequest.HttpServerRequest
  const idempotency = request.headers["idempotency-key"]
  if (idempotency != undefined && !(try Effect.try(() => validIdempotencyKey(idempotency)))) return try inferenceFailure("Use 8–128 letters, numbers, dots, underscores, colons, or hyphens in Idempotency-Key.", 400, ref)
  const multipart = path == "images/edits" || path == "audio/transcriptions" || path == "audio/translations" || path == "convert/file"
  let input: unknown = raw
  let form: FormData | undefined = undefined
  if (multipart) {
    const contentType = request.headers["content-type"] ?? ""
    if (!contentType.startsWith("multipart/form-data")) return try inferenceFailure("Send multipart form data.", 415, ref)
    form = tryPromise(() => multipartForm(request.source, contentType)) catch () => undefined
    if (form == undefined) return try inferenceFailure("The form data could not be read.", 400, ref)
    const formInput = try Effect.try(() => multipartInput(form!, fallbackModel))
    if (!formInput.ok) return try inferenceFailure(formInput.message, formInput.status, ref)
    const valid = try Effect.try(() => validateMultipart(path, form!))
    if (!valid.ok) return try inferenceFailure(valid.message, valid.status, ref)
    input = formInput.value
  }
  const parsedResult = multipart ? { ok: true as const, value: input as Record<string, unknown> } : try Effect.try(() => parseSpecialized(path, raw))
  if (!parsedResult.ok) return try inferenceFailure(parsedResult.message, parsedResult.status, ref)
  const fields = parsedResult.value
  const named = typeof fields.model == "string" && fields.model != "" ? fields.model : fallbackModel
  let meterKey = key
  if (key == undefined && wallet == "") {
    const auth = try authorized(endpoint, named)
    if ("refused" in auth) {
      const r = auth.refused as { error: unknown; status: number }
      return try refusalReply(r, ref)
    }
    meterKey = auth.key
  }
  const meterWallet = wallet == "" ? meterKey?.wallet ?? "" : wallet
  let servingRef = ref
  if (idempotency != undefined) servingRef = try Effect.try(() => idempotentRef(meterWallet, meterKey?.id ?? "console", idempotency))
  const inputTokens = try Effect.try(() => specializedInputTokens(path, fields))
  const outputTokens = path == "responses" ? (typeof fields.max_output_tokens == "number" ? fields.max_output_tokens : 1024) : path == "systemone" ? 256 : 0
  const routeResult = try Effect.try(() => specializedRoute(path, named, inputTokens, false, outputTokens))
  if (!routeResult.ok) return try inferenceFailure(routeResult.message, routeResult.status, servingRef)
  const selected = routeResult.value
  if (typeof fields.max_cost_microusd == "number" && selected.reserve > fields.max_cost_microusd) return try inferenceFailure("The estimated reservation exceeds max_cost_microusd.", 400, servingRef)
  const opened = try openMeter(servingRef, meterWallet, meterKey, endpoint, named, false, selected.reserve, meterProvider(selected.provider))
  if ("refused" in opened) {
    const r = opened.refused as { error: unknown; status: number }
    return try refusalReply(r, servingRef)
  }
  const meter = opened.meter
  const providerAt = try Clock.currentTimeMillis
  const upstream = tryPromise(() => callSpecialized(path, selected, form ?? fields)) catch () => undefined
  const providerMs = try Clock.currentTimeMillis - providerAt
  if (upstream == undefined) {
    // spec/app/gateway/requests.md, "A request that cannot be served fails without a charge": the
    // transport failed before any response, so nothing was served and the reservation releases.
    try failMeter(meter, false)
    return try inferenceFailure("The provider did not respond. Nothing was served, so nothing was charged.", 502, servingRef)
  }
  const response = upstream.response
  if (!response.ok) {
    // spec/app/gateway/requests.md, "A request that cannot be served fails without a charge": the
    // provider refused or failed the request before serving anything, so the reservation releases.
    try failMeter(meter, false)
    return try inferenceFailure("The provider could not complete this request. Nothing was served, so nothing was charged.", 502, servingRef)
  }
  if (path == "audio/speech") {
    const bytesResult = tryPromise(async () => new Uint8Array(await response.arrayBuffer())) catch () => undefined
    if (bytesResult == undefined || bytesResult.byteLength == 0) {
      try failMeter(meter, true)
      return try inferenceFailure("The provider returned an incomplete result.", 502, servingRef)
    }
    const settled = try settleMeter(meter, inputTokens, 0, -1, selected.reserve, providerMs)
    if ("refused" in settled) {
      const r = settled.refused as { error: unknown; status: number }
      return try refusalReply(r, servingRef)
    }
    return HttpServerResponse.uint8Array(bytesResult, {
      contentType: response.headers.get("content-type") ?? "audio/mpeg",
      headers: { ...noStore, "X-Sonnely-Request-Id": servingRef, "X-Sonnely-Provider": selected.provider },
    })
  }
  const output = tryPromise(() => response.json()) catch () => undefined
  if (output == undefined) {
    try failMeter(meter, true)
    return try inferenceFailure("The provider returned an incomplete result or usage record.", 502, servingRef)
  }
  const decision = try Effect.try(() => settleUsageCost(selected.route, selected.reserve, path, output))
  if (decision.kind == "unmeasured") {
    // spec/app/usage.md, "A pending request can fail or go under review": a token-priced route whose
    // usage the provider did not meter can never complete at zero cost — the capture is the whole
    // reservation under review, and the served result still reaches the client below.
    try failMeter(meter, true)
  } else {
    const settled = try settleMeter(meter, decision.input, decision.output, -1, decision.cost, providerMs)
    if ("refused" in settled) {
      const r = settled.refused as { error: unknown; status: number }
      return try refusalReply(r, servingRef)
    }
  }
  const body = typeof output == "object" && output != null && !Array.isArray(output) ? output as Record<string, unknown> : { data: output }
  const trimmed = try Effect.try(() => sliceTopResults(path, body, fields.top_n))
  const answered = try reply({ ...trimmed, model: named, sonnely_request_id: servingRef, sonnely_provider: selected.provider })
  return HttpServerResponse.setHeaders(answered, { "X-Sonnely-Request-Id": servingRef, "X-Sonnely-Provider": selected.provider })
}

function endpointRoute({ path, endpoint, model, shape }: (typeof endpoints)[number]) {
  const handler = effect {
    const request = try HttpServerRequest.HttpServerRequest
    const multipart = path == "images/edits" || path == "audio/transcriptions" || path == "audio/translations" || path == "convert/file"
    if (!multipart && !request.headers["content-type"]?.startsWith("application/json")) return try oops("send application/json", 415)
    const raw = multipart ? undefined : request.json catch () => undefined
    const liveProviders = try Effect.try(() => configuredProviders())
    if (liveProviders.length > 0 || !(try Effect.try(() => stagingInference()))) {
      const ref = try Effect.try(() => newRef())
      return try inferSpecialized(path, endpoint, model({}), raw, undefined, "", ref)
    }
    const named = model(raw)
    const auth = try authorized(endpoint, named)
    if ("refused" in auth) {
      const r = auth.refused as { error: unknown; status: number }
      return try refusalReply(r, "")
    }
    const idempotency = request.headers["idempotency-key"]
    if (idempotency != undefined && !(try Effect.try(() => validIdempotencyKey(idempotency)))) return try inferenceFailure("Use 8–128 letters, numbers, dots, underscores, colons, or hyphens in Idempotency-Key.", 400, "")
    let ref: string = try Effect.try(() => newRef())
    if (idempotency != undefined) ref = try Effect.try(() => idempotentRef(auth.key.wallet, auth.key.id, idempotency))
    const cost = stagedCost(JSON.stringify(raw ?? {}).length)
    const settled = try stageMeter(ref, auth.key, endpoint, named, false, [], cost)
    if ("refused" in settled) {
      const r = settled.refused as { error: unknown; status: number }
      return try refusalReply(r, ref)
    }
    const response = try reply(shape(ref, named, cost))
    return HttpServerResponse.setHeaders(response, { "X-Sonnely-Request-Id": ref, "X-Sonnely-Provider": "staging" })
  }
  return HttpRouter.add("POST", `/api/sonnely/v1/${path}`, provideService(handler, HttpServerRequest.MaxBodySize, ByteSize.kibibytes(3072)))
}

/** The model catalog in the OpenAI list shape. */
effect function listModels() {
  return try reply(try Effect.try(() => modelsPayload()))
}

/** The provider inventory staging routes over. */
effect function providerModels() {
  return try reply(try Effect.try(() => providerModelsPayload()))
}

/** The authenticated key's own status. */
effect function keyStatus() {
  const request = try HttpServerRequest.HttpServerRequest
  const id = bearerId(request)
  const keys = try WorkspaceKeys.Machine
  const state = try keys.get()
  const key = id == "" ? undefined : state.keys.find((k) => k.hash == id)
  if (key == undefined) return try oops("A valid bearer key is required.", 401)
  const now = try Clock.currentTimeMillis
  return try reply({ data: try Effect.try(() => keyStatusPayload(key, now)) })
}

// spec/app/gateway/batch.md, "Story: Run a resumable batch": the job is created once, sent row by row
// and cleared by the wallet that owns it — one job per wallet, a fleet instance under "gateway-batch:<wallet>".
interface BatchMachine {
  get(): unknown!!
  send(event: unknown): unknown!unknown
}

effect function batchWallet() {
  const request = try HttpServerRequest.HttpServerRequest
  if (bearerId(request) != "") {
    const auth = try bearerKey()
    if ("refused" in auth) return { refused: auth.refused }
    return { wallet: auth.key.wallet }
  }
  const wallet = try authenticatedWallet()
  if (wallet == "") return { refused: { error: { message: "A valid bearer key is required.", type: "invalid_request_error" }, status: 401 } }
  return { wallet }
}

effect function batchInstance(wallet: string) {
  const fleet = try Fleet
  return (try fleet.machine("gateway-batch", wallet)) as unknown as BatchMachine
}

effect function batchCreate() {
  const request = try HttpServerRequest.HttpServerRequest
  if (!request.headers["content-type"]?.startsWith("application/json")) return try oops("send application/json", 415)
  const owner = try batchWallet()
  if ("refused" in owner) {
    const r = owner.refused as { error: unknown; status: number }
    return try refusalReply(r, "")
  }
  const raw = request.json catch () => undefined
  const input = raw as { id?: unknown; filename?: unknown; customIds?: unknown } | undefined
  const id = typeof input?.id == "string" ? input.id : ""
  const filename = typeof input?.filename == "string" ? input.filename : ""
  const customIds = Array.isArray(input?.customIds) ? input!.customIds.filter((c): c is string => typeof c == "string") : []
  const batch = try batchInstance(owner.wallet)
  const now = try Clock.currentTimeMillis
  const created = batch.send({ type: "create", id, filename, customIds, createdAt: now }) catch (e) => e
  if (created instanceof Batch.Rejected) return try oops("A different batch job is running, or these rows do not fit (1-200 non-empty unique custom ids).", 409)
  return try reply({ ok: true, job: id })
}

effect function batchShow() {
  const owner = try batchWallet()
  if ("refused" in owner) {
    const r = owner.refused as { error: unknown; status: number }
    return try refusalReply(r, "")
  }
  const batch = try batchInstance(owner.wallet)
  return try reply(try batch.get())
}

effect function batchClear() {
  const owner = try batchWallet()
  if ("refused" in owner) {
    const r = owner.refused as { error: unknown; status: number }
    return try refusalReply(r, "")
  }
  const batch = try batchInstance(owner.wallet)
  const cleared = batch.send({ type: "clear" }) catch (e) => e
  if (cleared instanceof Batch.Rejected) return try oops("No batch job is running.", 409)
  return try reply({ ok: true })
}

effect function batchInterrupt() {
  const request = try HttpServerRequest.HttpServerRequest
  if (!request.headers["content-type"]?.startsWith("application/json")) return try oops("send application/json", 415)
  const owner = try batchWallet()
  if ("refused" in owner) {
    const r = owner.refused as { error: unknown; status: number }
    return try refusalReply(r, "")
  }
  const raw = request.json catch () => undefined
  const customId = typeof (raw as any)?.customId == "string" ? (raw as any).customId : ""
  const batch = try batchInstance(owner.wallet)
  const cut = batch.send({ type: "interrupt", customId }) catch (e) => e
  if (cut instanceof Batch.Rejected) return try oops("That row is not in flight.", 409)
  return try reply({ ok: true })
}

// spec/app/gateway/batch.md — one row of the job: begun, served as a non-streaming chat completion,
// resolved Succeeded; a repeated row resolves Review rather than charging twice.
effect function batchChat() {
  const request = try HttpServerRequest.HttpServerRequest
  if (!request.headers["content-type"]?.startsWith("application/json")) return try oops("send application/json", 415)
  const raw = request.json catch () => undefined
  const body = chatBody(raw)
  if (body.stream) return try oops("Batch rows must be non-streaming chat completions.", 400)
  const auth = try authorized("ChatCompletions", body.model)
  if ("refused" in auth) {
    const r = auth.refused as { error: unknown; status: number }
    return try refusalReply(r, "")
  }
  const wallet = request.headers["x-sonnely-batch-wallet"] ?? ""
  if (wallet == "" || wallet != auth.key.wallet) return try inferenceFailure("The batch wallet does not match this key's workspace.", 403, "")
  const idempotency = request.headers["idempotency-key"] ?? ""
  if (!/^batch:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}:\d+$/i.test(idempotency)) {
    return try inferenceFailure("Use Idempotency-Key batch:<uuidv4>:<row index>.", 400, "")
  }
  const ref = try Effect.try(() => idempotentRef(auth.key.wallet, auth.key.id, idempotency))
  const liveProviders = try Effect.try(() => configuredProviders())
  if (liveProviders.length > 0 || !(try Effect.try(() => stagingInference()))) return try inferChat(raw, auth.key, auth.key.wallet, ref)
  const cost = stagedCost(body.bytes)
  const settled = try stageMeter(ref, auth.key, "ChatCompletions", body.model, false, [], cost)
  if ("refused" in settled) {
    const r = settled.refused as { error: unknown; status: number }
    return try refusalReply(r, ref)
  }
  const response = try reply(completionShape(ref, body.model, cost))
  return HttpServerResponse.setHeaders(response, { "X-Sonnely-Request-Id": ref, "X-Sonnely-Provider": "staging" })
}

/** /api/v1 is retired: every method answers 410. */
effect function gone() {
  return try reply({ error: { message: "/api/v1 is retired; use /api/sonnely/v1.", type: "gone" } }, 410)
}

/** The keyring machine, stored under "keys" — the workspace shares the key. */
export function keyringMachine() {
  return Keyring.stored("keys")
}

/** The request ledger, stored under "gateway-requests". */
export function requestsMachine() {
  return Requests.stored("gateway-requests")
}

/** The batch machine over one stored instance, for tests and drivers. */
export function batchMachine() {
  return Batch.stored("gateway-batch")
}

/** An event from anywhere untrusted, decoded before the keyring's rules see it. */
export effect function dispatchKeyring(input: unknown) {
  const machine = try Keyring.Machine
  return try machine.receive(input)
}

/** An event from anywhere untrusted, decoded before the ledger's rules see it. */
export effect function dispatchRequests(input: unknown) {
  const machine = try Requests.Machine
  return try machine.receive(input)
}

/** An event from anywhere untrusted, decoded before the batch rules see it. */
export effect function dispatchBatch(input: unknown) {
  const machine = try Batch.Machine
  return try machine.receive(input)
}

// spec/app/gateway/index.md — the API surface: machine state and streams are read-only; every write
// goes through the guards above.
export const gatewayApi = Layer.unwrap(effect {
  const keyring = try Keyring.Machine
  const requests = try Requests.Machine
  return Layer.mergeAll(
    HttpRouter.add("GET", "/api/machines/keys", getState(keyring)),
    HttpRouter.add("GET", "/api/machines/keys/stream", getStream(keyring)),
    HttpRouter.add("GET", "/api/machines/gateway-requests", getState(requests)),
    HttpRouter.add("GET", "/api/machines/gateway-requests/stream", getStream(requests)),
    HttpRouter.add("GET", "/api/sonnely/v1/models", listModels()),
    HttpRouter.add("GET", "/api/sonnely/v1/provider-models", providerModels()),
    HttpRouter.add("GET", "/api/sonnely/v1/key", keyStatus()),
    HttpRouter.add("POST", "/api/sonnely/v1/chat/completions", provideService(chatCompletions(), HttpServerRequest.MaxBodySize, ByteSize.kibibytes(256))),
    ...endpoints.map(endpointRoute),
    HttpRouter.add("POST", "/api/sonnely/batch", provideService(batchCreate(), HttpServerRequest.MaxBodySize, ByteSize.kibibytes(256))),
    HttpRouter.add("GET", "/api/sonnely/batch", batchShow()),
    HttpRouter.add("DELETE", "/api/sonnely/batch", batchClear()),
    HttpRouter.add("POST", "/api/sonnely/batch/interrupt", provideService(batchInterrupt(), HttpServerRequest.MaxBodySize, ByteSize.kibibytes(256))),
    HttpRouter.add("POST", "/api/sonnely/batch/chat", provideService(batchChat(), HttpServerRequest.MaxBodySize, ByteSize.kibibytes(256))),
    HttpRouter.add("GET", "/api/v1/*", gone()),
    HttpRouter.add("POST", "/api/v1/*", gone()),
    HttpRouter.add("PUT", "/api/v1/*", gone()),
    HttpRouter.add("PATCH", "/api/v1/*", gone()),
    HttpRouter.add("DELETE", "/api/v1/*", gone()),
  )
})

/** The gateway machines' state, kept under `dir`; each wallet's batch job is a fleet instance over the same store. */
export function gatewayState(dir: string) {
  return Layer.mergeAll(
    Layer.provide(Keyring.stored("keys"), stateStore(dir)),
    Layer.provide(Requests.stored("gateway-requests"), stateStore(dir)),
  )
}
