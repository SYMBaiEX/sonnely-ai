// spec/app/usage.md, "Story: Meter a request": the usage meter behind the verified-session
// boundary. Reads project the requesting wallet's rows plus project rows of teams it belongs to,
// and every write's trusted sender is that wallet — never a wallet or sender supplied by the client.
import * as Usage from "../../gen/app__usage.effect.vibe"
import { stateStore } from "../serve.vibe"
import { authenticatedWallet } from "./session.vibe"
import { memberProjectsFor } from "./teams.vibe"

const noStore = { "cache-control": "no-store" }

effect function reply(value: unknown, status: number = 200) {
  return try HttpServerResponse.json(value, { status, headers: noStore })
}

effect function projectState(state: Usage.Usage, wallet: string) {
  return { rows: Usage.visibleRows(state, wallet, try memberProjectsFor(wallet)) }
}

effect function getState(usage: Usage.Machine.Shape) {
  const wallet = try authenticatedWallet()
  if (wallet == "") return try reply({ error: "sign in required" }, 401)
  return try reply(try projectState(try usage.get(), wallet))
}

effect function getStream(usage: Usage.Machine.Shape) {
  const wallet = try authenticatedWallet()
  if (wallet == "") return try reply({ error: "sign in required" }, 401)
  const pushes = Stream.mapEffect(usage.changes, (state) => effect {
    const visible = try projectState(state, wallet)
    return `data: ${JSON.stringify(visible)}\n\n`
  })
  return HttpServerResponse.stream(Stream.encodeText(pushes), {
    contentType: "text/event-stream",
    headers: noStore,
  })
}

// The UsageMax export is a download of the settled rows the console already shows the wallet,
// including team project rows, as a JSON file. Rows settle complete; the export covers the
// requested number of days and at most the 100 most recent of them.
function exportDays(raw: unknown) {
  const days = typeof raw == "string" ? Number(raw) : typeof raw == "number" ? raw : 30
  if (!Number.isSafeInteger(days) || days < 1) return 30
  return Math.min(days, 366)
}

effect function exportDownload(usage: Usage.Machine.Shape, days: number) {
  const wallet = try authenticatedWallet()
  if (wallet == "") return try reply({ error: "sign in required" }, 401)
  const now = try Clock.currentTimeMillis
  const since = now - days * 86_400_000
  const rows = (try projectState(try usage.get(), wallet)).rows.filter((row) => row.status == "Complete" && row.time >= since).slice(-100)
  const filename = "sonnely-usage-max-" + new Date(now).toISOString().slice(0, 10) + ".json"
  return try HttpServerResponse.json({ rows }, {
    headers: { ...noStore, "content-disposition": "attachment; filename=\"" + filename + "\"" },
  })
}

effect function getUsageMax(usage: Usage.Machine.Shape) {
  const request = try HttpServerRequest.HttpServerRequest
  return try exportDownload(usage, exportDays(new URL(request.url, "http://usage").searchParams.get("days") ?? undefined))
}

effect function postUsageMax(usage: Usage.Machine.Shape) {
  const request = try HttpServerRequest.HttpServerRequest
  const input = (request.json catch () => undefined) as { days?: unknown } | undefined
  return try exportDownload(usage, exportDays(input?.days))
}

export const usageApi = Layer.unwrap(effect {
  const usage = try Usage.Machine
  return Layer.mergeAll(
    HttpRouter.add("GET", "/api/machines/usage", getState(usage)),
    HttpRouter.add("GET", "/api/machines/usage/stream", getStream(usage)),
    HttpRouter.add("GET", "/api/sonnely/usage-max", getUsageMax(usage)),
    HttpRouter.add("POST", "/api/sonnely/usage-max", provideService(postUsageMax(usage), HttpServerRequest.MaxBodySize, ByteSize.kibibytes(16))),
  )
})

/** The meter machine, kept under "usage". */
export const usage = Usage.stored("usage")

/** An event from anywhere untrusted, decoded before the rules see it. */
export effect function dispatch(input: unknown, by: unknown) {
  const machine = try Usage.Machine
  return try machine.receive(input, try Usage.decodeSender(by))
}

export function usageState(dir: string) {
  return Layer.provide(usage, stateStore(dir))
}
