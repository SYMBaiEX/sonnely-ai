// spec/app/usage.md, "Story: Meter a request": the usage meter behind the verified-session
// boundary. Reads project only the requesting wallet's rows, and every write's trusted sender is
// that wallet — never a wallet or sender supplied by the client.
import * as Usage from "../../gen/app__usage.effect.vibe"
import { stateStore } from "../serve.vibe"
import { authenticatedWallet } from "./session.vibe"

const noStore = { "cache-control": "no-store" }

effect function reply(value: unknown, status: number = 200) {
  return try HttpServerResponse.json(value, { status, headers: noStore })
}

function project(state: Usage.Usage, wallet: string): Usage.Usage {
  return { rows: state.rows.filter((row) => row.wallet == wallet) }
}

effect function getState(usage: Usage.Machine.Shape) {
  const wallet = try authenticatedWallet()
  if (wallet == "") return try reply({ error: "sign in required" }, 401)
  return try reply(project(try usage.get(), wallet))
}

effect function getStream(usage: Usage.Machine.Shape) {
  const wallet = try authenticatedWallet()
  if (wallet == "") return try reply({ error: "sign in required" }, 401)
  const pushes = Stream.map(usage.changes, (state) => `data: ${JSON.stringify(project(state, wallet))}\n\n`)
  return HttpServerResponse.stream(Stream.encodeText(pushes), {
    contentType: "text/event-stream",
    headers: noStore,
  })
}

export const usageApi = Layer.unwrap(effect {
  const usage = try Usage.Machine
  return Layer.mergeAll(
    HttpRouter.add("GET", "/api/machines/usage", getState(usage)),
    HttpRouter.add("GET", "/api/machines/usage/stream", getStream(usage)),
  )
})

/** The meter machine, kept under "usage". */
export const usage = Usage.stored("usage")

/** An event from anywhere untrusted, decoded before the rules see it. */
export effect function dispatch(input: unknown, by: unknown) {
  const machine = try Usage.Machine
  return try machine.receive(input, try Usage.decodeSender(by))
}

export function usageState(dir: string) {
  return Layer.provide(usage, stateStore(dir))
}
