// spec/app/console/chat.md, "Story: Converse with a model": the playground machine, the responder behind it, and the endpoint that turns a send into an answer.
import { Machine, stored, initial } from "../../../gen/app__console__chat.effect.vibe"
import { Machine as LogsMachine } from "../../../gen/app__console__logs.effect.vibe"
import type { Chat } from "../../../gen/app__console__chat.ts"
import type { LogEntry } from "../../../gen/app__console__logs.ts"
import { catalog, providerOf } from "../../../gen/app__console__catalog.ts"
import { machineApi } from "../../machines.vibe"
import { store } from "../../serve.vibe"

const noStore = { "cache-control": "no-store" }

/** What answers a prompt: on staging a deterministic local responder; the inference gateway takes its place in production. */
export service Responder {
  static readonly key = "sonnely/console/chat#Responder"
  reply(prompt: string, model: string): string!!
}

/** The deterministic local responder, default until a gateway is provided. */
const local: Responder.Shape = {
  effect reply(prompt: string, model: string) {
    const canned = samples.find((sample) => sample.prompt === prompt)
    if (canned) return canned.reply
    return `You asked ${model}: "${prompt}". This staging workspace answers locally, outside any enclave — in production this prompt runs in a trusted execution environment and the gateway streams the model's answer back with a receipt.`
  },
}

const samples = [
  {
    prompt: "What is a trusted execution environment?",
    reply:
      "A trusted execution environment (TEE) is an isolated part of a computer designed to protect data while it’s being processed. An attestation report can help a client check what software and hardware are running inside it. In Sonnely’s setup, the confidential enclave that runs the model and the Sonnely gateway are separate trust boundaries.",
  },
  {
    prompt: "Show a simple API key budget example.",
    reply:
      "If a key has a $5 daily limit and a $30 lifetime limit, requests stop when either budget would be exceeded. The gateway reserves an estimate before running each request, then releases the remainder after usage settles.",
  },
  {
    prompt: "How does a wallet sign-in work?",
    reply:
      "Your wallet signs a message tied to this site and a one-time challenge. The server checks the signature against your public Solana address and opens a session. Signing in does not send a transaction or move your funds.",
  },
]

function tokenEstimate(text: string) {
  return Math.max(1, Math.ceil(text.length / 4))
}

/** The last user prompt of the thread `id` in `state`, or undefined. */
function lastPrompt(state: Chat, id: string) {
  const thread = state.threads.find((t) => t.id === id)
  const message = thread?.messages[thread.messages.length - 1]
  return message?.role === "User" ? message.content : undefined
}

/** Answer the last user message of thread `id`: stream the responder's answer through `reply` events, then log the request. */
export effect function completeReply(id: string, model: string) {
  const machine = try Machine
  const responder = try Responder
  const state = try machine.get()
  const prompt = lastPrompt(state, id)
  if (prompt === undefined) throw new NoPrompt({ id })
  const started = try Clock.currentTimeMillis
  const answer = try responder.reply(prompt, model)
  const parts = Math.ceil(answer.length / 40)
  for (let at = 1; at <= parts; at++) {
    try machine.send({ type: "reply", id, model, text: answer.slice(0, at * 40) })
    try Effect.sleep("40 millis")
  }
  const entry = recordEntry(id, model, prompt, answer, try Clock.currentTimeMillis - started)
  const logs = try LogsMachine
  const _logged = logs.send({ type: "record", entry }) catch () => undefined
  return entry
}

/** The request-log row a completed reply leaves behind. */
function recordEntry(id: string, model: string, prompt: string, answer: string, durationMs: number): LogEntry {
  const input = tokenEstimate(prompt)
  const output = tokenEstimate(answer)
  const route = catalog.flatMap((m) => m.routes).find((r) => r.endpoint === "chat/completions" && r.modelId === model)
  const cost = route ? Math.ceil((input * Math.max(0, route.input) + output * Math.max(0, route.output)) / 1_000_000) : 0
  return {
    id: `req-${Math.abs([...id].reduce((a, c) => (a * 31 + c.charCodeAt(0)) | 0, 7)).toString(16)}`,
    model,
    provider: providerOf(catalog, model),
    endpoint: "chat/completions",
    keyName: "playground",
    status: "Complete",
    input,
    output,
    cost,
    durationMs,
    ageDays: 0,
  }
}

/** There is no pending user message to answer. */
export error NoPrompt { id: string }

effect function replyRoute() {
  const request = try HttpServerRequest.HttpServerRequest
  if (!request.headers["content-type"]?.startsWith("application/json")) {
    return try HttpServerResponse.json({ error: "send application/json" }, { status: 415, headers: noStore })
  }
  const body = request.json catch () => undefined
  const parsed = body as { id?: unknown; model?: unknown } | undefined
  if (!parsed || typeof parsed.id !== "string" || typeof parsed.model !== "string") {
    return try HttpServerResponse.json({ error: "send {id, model}" }, { status: 400, headers: noStore })
  }
  const answered = completeReply(parsed.id, parsed.model) catch effect (error) => { return error }
  if (answered && typeof answered === "object" && "_tag" in (answered as object)) {
    return try HttpServerResponse.json({ ok: false, error: (answered as { _tag: string })._tag }, { status: 409, headers: noStore })
  }
  return try HttpServerResponse.json({ ok: true, entry: answered }, { headers: noStore })
}

export const chatApi = Layer.unwrap(effect {
  return Layer.mergeAll(
    machineApi("console__chat", try Machine),
    HttpRouter.add("POST", "/api/console/chat/reply", provideService(
      provideService(replyRoute(), HttpServerRequest.MaxBodySize, ByteSize.kibibytes(256)),
      Responder,
      local,
    )),
  )
})

export function chatState(dir: string) {
  return Layer.provide(stored("console__chat"), store(dir))
}

/** The chat machine's store, for tests and drivers. */
export const chatStore = stored("console__chat")

/** The empty chat, for tests and drivers. */
export { initial }

/** An untrusted input, decoded and applied to the chat machine. */
export effect function chatDispatch(input: unknown) {
  const machine = try Machine
  return try machine.receive(input)
}
