// spec/app/console/chat.md, "Story: Converse with a model"
import { Machine, stored, initial } from "../../../gen/app__console__chat.effect.vibe"
import type { Chat } from "../../../gen/app__console__chat.ts"
import type { Console as ConsoleSettings } from "../../../gen/app__console.ts"
import type { Endpoint as GatewayEndpoint } from "../../../gen/app__gateway__requests.ts"
import { fleetMachineApi } from "../../machines.vibe"
import { Fleet } from "../../fleet.vibe"
import { inferChat, inferSpecialized } from "../gateway.vibe"
import { authenticatedWallet } from "../session.vibe"
import { configuredProviders, stagingInference } from "../gateway/providers.ts"

module playgroundNode {
  import { randomUUID } from "node:crypto"
  export function newRef() {
    return randomUUID()
  }
  export function silentWav() {
    const samples = 1600
    const bytes = new Uint8Array(44 + samples * 2)
    const view = new DataView(bytes.buffer)
    const write = (offset: number, value: string) => {
      for (let index = 0; index < value.length; index++) bytes[offset + index] = value.charCodeAt(index)
    }
    write(0, "RIFF")
    view.setUint32(4, 36 + samples * 2, true)
    write(8, "WAVE")
    write(12, "fmt ")
    view.setUint32(16, 16, true)
    view.setUint16(20, 1, true)
    view.setUint16(22, 1, true)
    view.setUint32(24, 16000, true)
    view.setUint32(28, 32000, true)
    view.setUint16(32, 2, true)
    view.setUint16(34, 16, true)
    write(36, "data")
    view.setUint32(40, samples * 2, true)
    return bytes
  }
}
import { newRef, silentWav } from playgroundNode

const noStore = { "cache-control": "no-store" }
const plainWritingInstruction = "Answer in concise, clear language."

effect function plainWritingOn(fleet: Fleet.Shape, wallet: string) {
  const machine = try fleet.machine("console", wallet)
  const state = (try machine.get()) as ConsoleSettings
  return state.plain
}

function withPlainWriting(messages: { role: string; content: string }[], plain: boolean) {
  return plain ? [{ role: "system", content: plainWritingInstruction }, ...messages] : messages
}

effect function replyRoute() {
  const request = try HttpServerRequest.HttpServerRequest
  if (!request.headers["content-type"]?.startsWith("application/json")) {
    return try HttpServerResponse.json({ error: "send application/json" }, { status: 415, headers: noStore })
  }
  const wallet = try authenticatedWallet()
  if (wallet == "") return try HttpServerResponse.json({ error: "Sign in with a Solana wallet." }, { status: 401, headers: noStore })
  const raw = request.json catch () => undefined
  const parsed = raw as { id?: unknown; model?: unknown; provider?: unknown; fallbacks?: unknown } | undefined
  if (!parsed || typeof parsed.id !== "string" || typeof parsed.model !== "string") {
    return try HttpServerResponse.json({ error: "send {id, model}" }, { status: 400, headers: noStore })
  }
  const fleet = try Fleet
  const machine = try fleet.machine("console__chat", wallet)
  const state = (try machine.get()) as Chat
  const thread = state.threads.find((item) => item.id === parsed.id)
  if (thread == undefined || thread.messages[thread.messages.length - 1]?.role !== "User") {
    return try HttpServerResponse.json({ error: "There is no pending user message to answer." }, { status: 409, headers: noStore })
  }
  const messages = thread.messages.map((message) => message.role == "User" ? { role: "user", content: message.content } : { role: "assistant", content: message.content })
  const fallbacks = Array.isArray(parsed.fallbacks) ? parsed.fallbacks.filter((provider): provider is "near-ai" | "phala" | "tinfoil" => provider == "near-ai" || provider == "phala" || provider == "tinfoil") : []
  const primary = parsed.provider == "phala" || parsed.provider == "tinfoil" ? parsed.provider : "near-ai"
  const only = [primary, ...fallbacks.filter((provider) => provider != primary)] as ["near-ai" | "phala" | "tinfoil"]
  const plain = try plainWritingOn(fleet, wallet)
  const ref = try Effect.try(() => newRef())
  return try inferChat({
    model: parsed.model,
    messages: withPlainWriting(messages, plain),
    provider: { only, ...(only.length > 1 ? { allow_fallbacks: true } : {}) },
  }, undefined, wallet, ref, request.headers["x-sonnely-receipt"] == "v1")
}

effect function streamRoute() {
  const request = try HttpServerRequest.HttpServerRequest
  if (!request.headers["content-type"]?.startsWith("application/json")) {
    return try HttpServerResponse.json({ error: "send application/json" }, { status: 415, headers: noStore })
  }
  const wallet = try authenticatedWallet()
  if (wallet == "") return try HttpServerResponse.json({ error: "Sign in with a Solana wallet." }, { status: 401, headers: noStore })
  const raw = request.json catch () => undefined
  const parsed = raw as { id?: unknown; model?: unknown; provider?: unknown; fallbacks?: unknown } | undefined
  if (!parsed || typeof parsed.id !== "string" || typeof parsed.model !== "string") {
    return try HttpServerResponse.json({ error: "send {id, model}" }, { status: 400, headers: noStore })
  }
  const fleet = try Fleet
  const machine = try fleet.machine("console__chat", wallet)
  const state = (try machine.get()) as Chat
  const thread = state.threads.find((item) => item.id === parsed.id)
  if (thread == undefined || thread.messages[thread.messages.length - 1]?.role !== "User") {
    return try HttpServerResponse.json({ error: "There is no pending user message to answer." }, { status: 409, headers: noStore })
  }
  const messages = thread.messages.map((message) => message.role == "User" ? { role: "user", content: message.content } : { role: "assistant", content: message.content })
  const fallbacks = Array.isArray(parsed.fallbacks) ? parsed.fallbacks.filter((provider): provider is "near-ai" | "phala" | "tinfoil" => provider == "near-ai" || provider == "phala" || provider == "tinfoil") : []
  const primary = parsed.provider == "phala" || parsed.provider == "tinfoil" ? parsed.provider : "near-ai"
  const only = [primary, ...fallbacks.filter((provider) => provider != primary)] as ["near-ai" | "phala" | "tinfoil"]
  const plain = try plainWritingOn(fleet, wallet)
  const input = {
    model: parsed.model,
    messages: withPlainWriting(messages, plain),
    stream: true,
    stream_options: { include_usage: true },
    provider: { only, ...(only.length > 1 ? { allow_fallbacks: true } : {}) },
  }
  const ref = try Effect.try(() => newRef())
  return try inferChat(input, undefined, wallet, ref, request.headers["x-sonnely-receipt"] == "v1")
}

function playgroundShape(endpoint: string, ref: string) {
  const staged = "Sonnely staging: this playground endpoint answers deterministic output; no provider is upstream."
  if (endpoint === "responses") return { id: `resp-${ref}`, object: "response", created: 0, output: [{ type: "message", role: "assistant", content: [{ type: "output_text", text: staged }] }], status: "completed", sonnely_request_id: ref }
  if (endpoint === "embeddings") return { object: "list", data: [{ object: "embedding", embedding: [0.5, 0.5], index: 0 }], sonnely_request_id: ref }
  if (endpoint === "rerank") return { object: "list", results: [{ index: 0, relevance_score: 0.91 }, { index: 1, relevance_score: 0.42 }], sonnely_request_id: ref }
  if (endpoint === "systemone") return { answers: { decision: { noul: 0.87 } }, output_text: staged, sonnely_request_id: ref }
  if (endpoint === "redact") return { redacted_text: staged, sonnely_request_id: ref }
  if (endpoint === "convert/file") return { document: { md_content: "# Converted document\n\n" + staged }, sonnely_request_id: ref }
  if (endpoint === "images/generations" || endpoint === "images/edits") return { created: 0, data: [{ b64_json: "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==" }], sonnely_request_id: ref }
  return { text: staged, sonnely_request_id: ref }
}

function gatewayEndpoint(endpoint: string): GatewayEndpoint {
  if (endpoint == "embeddings") return "Embeddings"
  if (endpoint == "rerank") return "Rerank"
  if (endpoint == "responses") return "ResponsesApi"
  if (endpoint == "redact") return "Redact"
  if (endpoint == "systemone") return "Systemone"
  if (endpoint == "images/generations") return "ImageGenerations"
  if (endpoint == "images/edits") return "ImageEdits"
  if (endpoint == "audio/speech") return "AudioSpeech"
  if (endpoint == "audio/transcriptions") return "AudioTranscriptions"
  if (endpoint == "audio/translations") return "AudioTranslations"
  return "ConvertFile"
}

function specializedFallback(endpoint: string) {
  if (endpoint == "redact") return "pii-filter"
  if (endpoint == "systemone") return "levanto/sage-2"
  if (endpoint == "images/generations" || endpoint == "images/edits") return "black-forest-labs/FLUX.2-klein-4B"
  if (endpoint == "audio/speech") return "voxtral-tts"
  if (endpoint == "audio/transcriptions") return "whisper-large-v3-turbo"
  if (endpoint == "audio/translations") return "voxtral-small-24b"
  if (endpoint == "convert/file") return "doc-upload"
  return ""
}

// spec/app/console/chat.md, "Story: Converse with a model": the deterministic playground shapes are
// a staging convenience — unmetered and invented. Production never fake-serves: as the gateway does,
// anything but staging falls through to inferSpecialized, which refuses honestly when no provider is live.
effect function playgroundJson(endpoint: string) {
  const request = try HttpServerRequest.HttpServerRequest
  const wallet = try authenticatedWallet()
  if (wallet == "") return try HttpServerResponse.json({ error: "Sign in with a Solana wallet." }, { status: 401, headers: noStore })
  const liveProviders = try Effect.try(() => configuredProviders())
  if (liveProviders.length > 0 || !(try Effect.try(() => stagingInference()))) {
    const multipart = endpoint == "images/edits" || endpoint == "audio/transcriptions" || endpoint == "audio/translations" || endpoint == "convert/file"
    const raw = multipart ? undefined : request.json catch () => undefined
    const ref = try Effect.try(() => newRef())
    return try inferSpecialized(endpoint, gatewayEndpoint(endpoint), specializedFallback(endpoint), raw, undefined, wallet, ref)
  }
  const _body = request.text catch () => ""
  const ref = try Effect.try(() => newRef())
  const response = try HttpServerResponse.json(playgroundShape(endpoint, ref), { headers: noStore })
  return HttpServerResponse.setHeaders(response, { "X-Sonnely-Request-Id": ref, "X-Sonnely-Provider": "staging" })
}

effect function playgroundSpeech() {
  const request = try HttpServerRequest.HttpServerRequest
  const wallet = try authenticatedWallet()
  if (wallet == "") return try HttpServerResponse.json({ error: "Sign in with a Solana wallet." }, { status: 401, headers: noStore })
  const liveProviders = try Effect.try(() => configuredProviders())
  if (liveProviders.length > 0 || !(try Effect.try(() => stagingInference()))) {
    const raw = request.json catch () => undefined
    const ref = try Effect.try(() => newRef())
    return try inferSpecialized("audio/speech", "AudioSpeech", "voxtral-tts", raw, undefined, wallet, ref)
  }
  const _body = request.text catch () => ""
  const ref = try Effect.try(() => newRef())
  const bytes = try Effect.try(() => silentWav())
  const response = HttpServerResponse.uint8Array(bytes, { contentType: "audio/wav", headers: noStore })
  return HttpServerResponse.setHeaders(response, { "X-Sonnely-Request-Id": ref, "X-Sonnely-Provider": "staging" })
}

function playgroundRoute(path: string, endpoint: string) {
  return HttpRouter.add("POST", `/api/console/playground/${path}`, provideService(playgroundJson(endpoint), HttpServerRequest.MaxBodySize, ByteSize.kibibytes(3072)))
}

export const chatApi = Layer.unwrap(effect {
  return Layer.mergeAll(
    fleetMachineApi("console__chat", { events: ["newChat", "pickModel", "send", "reply", "edit", "open", "remove", "clearAll"] }),
    playgroundRoute("responses", "responses"),
    playgroundRoute("embeddings", "embeddings"),
    playgroundRoute("rerank", "rerank"),
    playgroundRoute("systemone", "systemone"),
    playgroundRoute("redact", "redact"),
    playgroundRoute("convert/file", "convert/file"),
    playgroundRoute("images/generations", "images/generations"),
    playgroundRoute("images/edits", "images/edits"),
    playgroundRoute("audio/transcriptions", "audio/transcriptions"),
    playgroundRoute("audio/translations", "audio/translations"),
    HttpRouter.add("POST", "/api/console/playground/audio/speech", provideService(playgroundSpeech(), HttpServerRequest.MaxBodySize, ByteSize.kibibytes(256))),
    HttpRouter.add("POST", "/api/console/chat/stream", provideService(streamRoute(), HttpServerRequest.MaxBodySize, ByteSize.kibibytes(256))),
    HttpRouter.add("POST", "/api/console/chat/reply", provideService(replyRoute(), HttpServerRequest.MaxBodySize, ByteSize.kibibytes(256))),
  )
})

export const chatStore = stored("console__chat")

export { initial }

export effect function chatDispatch(input: unknown) {
  const machine = try Machine
  return try machine.receive(input)
}
