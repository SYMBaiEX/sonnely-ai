import * as NodeRuntime from "@effect/platform-node/NodeRuntime"
import * as NodeServices from "@effect/platform-node/NodeServices"
import { adminApi, adminState } from "./api/admin.vibe"
import { billingApi, billingState } from "./api/billing.vibe"
import { consoleApi, consoleState } from "./api/console.vibe"
import { docsApi } from "./api/docs.vibe"
import { gatewayApi, gatewayState } from "./api/gateway.vibe"
import { healthApi } from "./api/health.vibe"
import { keysApi, keysState } from "./api/keys.vibe"
import { navApi, navState } from "./api/nav.vibe"
import { payoutsApi, payoutsState } from "./api/payouts.vibe"
import { sessionApi, sessionState } from "./api/session.vibe"
import { siteApi, siteState } from "./api/site.vibe"
import { supportApi, supportState } from "./api/support.vibe"
import { teamsApi, teamsState } from "./api/teams.vibe"
import { usageApi, usageState } from "./api/usage.vibe"
import { listening, serve } from "./serve.vibe"

effect function main() {
  const path = try Path.Path
  const web = try path.fromFileUrl(new URL("../web", import.meta.url))
  const dir = (try path.fromFileUrl(new URL("../data", import.meta.url)))
  const port = try Config.withDefault(Config.Number("PORT"), 0)
  const server = try Effect.try(() => serve(web, listening(port), Layer.mergeAll(healthApi, navApi, sessionApi, adminApi, billingApi, payoutsApi, siteApi, docsApi, gatewayApi, keysApi, usageApi, supportApi, teamsApi, consoleApi), Layer.mergeAll(navState(dir), sessionState(dir), adminState(dir), billingState(dir), payoutsState(dir), siteState(dir), gatewayState(dir), keysState(dir), usageState(dir), supportState(dir), teamsState(dir), consoleState(dir))))
  provide server {
    const { address } = try HttpServer.HttpServer
    if ("port" in address) try Console.log(`http://localhost:${address.port}`)
    try never
  }
}

NodeRuntime.runMain(main().pipe(Effect.provide(NodeServices.layer)))
