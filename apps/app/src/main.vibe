import * as NodeRuntime from "@effect/platform-node/NodeRuntime"
import * as NodeServices from "@effect/platform-node/NodeServices"
import { adminApi, adminState } from "./api/admin.vibe"
import { billingApi, billingState } from "./api/billing.vibe"
import { healthApi } from "./api/health.vibe"
import { navApi, navState } from "./api/nav.vibe"
import { sessionApi, sessionState } from "./api/session.vibe"
import { listening, serve } from "./serve.vibe"

effect function main() {
  const path = try Path.Path
  const web = try path.fromFileUrl(new URL("../web", import.meta.url))
  const dir = (try path.fromFileUrl(new URL("../data", import.meta.url)))
  const port = try Config.withDefault(Config.Number("PORT"), 3010)
  const server = try Effect.try(() => serve(web, listening(port), Layer.mergeAll(healthApi, navApi, sessionApi, adminApi, billingApi), Layer.mergeAll(navState(dir), sessionState(dir), adminState(dir), billingState(dir))))
  provide server {
    const { address } = try HttpServer.HttpServer
    if ("port" in address) try Console.log(`http://localhost:${address.port}`)
    try never
  }
}

NodeRuntime.runMain(main().pipe(Effect.provide(NodeServices.layer)))
