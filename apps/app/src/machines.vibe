// A domain area (spec/app/<area>.md -> gen/app__<area>.ts) mounts `machineApi("<area>", try Machine)`
// in its src/api/<area>.vibe, stored server-side as `Layer.provide(stored("<area>"), stateStore(dir))`.
// Every write over HTTP passes the verified-session boundary: the event type must be one a user may
// originate, identity fields are forced to the session wallet, and the machine's trusted sender is
// the session wallet — never anything the client supplied.
import * as Admin from "../gen/app__admin.effect.vibe"
import * as Session from "../gen/app__session.effect.vibe"
import * as Schedule from "effect/Schedule"
import { authenticatedSession, authenticatedWallet } from "./api/session.vibe"
import { Fleet, type FleetMachine } from "./fleet.vibe"

export interface MachineLike {
  get(): unknown!!
  // eslint-disable-next-line @typescript-eslint/no-explicit-any -- the channel payload type is erased at the protocol boundary
  receive(input: unknown, by?: string): any!any
  changes: Stream.Stream<unknown>
}

/** Which events a signed-in user may send one machine over HTTP, and how identity binds to the session. */
export interface WritePolicy {
  /** Event types a user may originate; anything else is refused before the machine sees it. */
  events: readonly string[]
  /** Event fields forced to the session wallet (actor-in-event machines); internal sends are unaffected. */
  bind?: readonly string[]
  /** Pass the session wallet as the machine's trusted sender (keys/usage-family machines). */
  sender?: boolean
}

export interface MachineReader {
  changes: Stream.Stream<unknown>
}

/** Row-level access for one machine: a projection keeps the state's shape but holds only what
 * the wallet may see. Operator machines never register here — they answer scoped endpoints only. */
export interface Scoping {
  /** "public" serves anonymous readers; "user" requires a verified session. */
  visibility: "public" | "user"
  /** Shape-preserving per-wallet row filter, applied on every read and stream frame. */
  project?: (state: any, wallet: string) => unknown
}

export interface RegisteredMachine {
  machine: MachineReader
  scoping: Scoping
}

service MachineRegistry {
  static readonly key = "@repo/app/machines/MachineRegistry"
  register(name: string, machine: MachineReader, scoping: Scoping): void!!
  entries(): Array<readonly [string, RegisteredMachine]>!!
}

const machineRegistry = Layer.effect(MachineRegistry, effect {
  const machines = try Ref.make(new Map<string, RegisteredMachine>())
  return {
    effect register(name: string, machine: MachineReader, scoping: Scoping) {
      try Ref.update(machines, (current) => {
        const next = new Map(current)
        next.set(name, { machine, scoping })
        return next
      })
    },
    effect entries() {
      return Array.from((try Ref.get(machines)).entries())
    },
  }
})

function registrationLayer(name: string, machine: MachineReader, scoping: Scoping) {
  return Layer.effectDiscard(effect {
    const registry = try MachineRegistry
    try registry.register(name, machine, scoping)
  })
}

export function machineRegistration(name: string, machine: MachineReader, scoping: Scoping = { visibility: "user" }) {
  return Layer.provideMerge(registrationLayer(name, machine, scoping), machineRegistry)
}

const noStore = { "cache-control": "no-store" }

// spec/app/admin/index.md, "Accounts are registered once": the first time the shell serves a
// wallet it reports the sighting to the admin machine, so moderation — suspend and reinstate —
// has a registered account to act on. Best-effort: a composition without the admin machine, or a
// registry already holding the account, simply skips it.
effect function observeFirstSeen(wallet: string) {
  if (wallet == "") return
  const found = try Effect.serviceOption(Admin.Machine)
  if (!Option.isSome(found)) return
  found.value.send({ type: "firstSeen", id: wallet, subject: "User" }, wallet) catch () => undefined
}

effect function getState(m: MachineLike, scoping: Scoping) {
  const wallet = try authenticatedWallet()
  if (scoping.visibility != "public" && wallet == "") return try HttpServerResponse.json({ error: "sign in required" }, { status: 401, headers: noStore })
  try observeFirstSeen(wallet)
  const state = try m.get()
  const scoped = scoping.project != undefined && wallet != "" ? scoping.project(state, wallet) : state
  return try HttpServerResponse.json(scoped, { headers: noStore })
}

// A write answers as a read does: the scoping projection of the state the event led to, or the
// refusal's reason alone. The machine's raw state never crosses the boundary, inside a Rejected
// failure least of all: it holds every row the projection exists to keep from the wallet.
effect function postEvent(m: MachineLike, policy: WritePolicy, scoping: Scoping) {
  const request = try HttpServerRequest.HttpServerRequest
  if (!request.headers["content-type"]?.startsWith("application/json")) {
    return try HttpServerResponse.json({ error: "send application/json" }, { status: 415, headers: noStore })
  }
  const wallet = try authenticatedWallet()
  if (wallet == "") return try HttpServerResponse.json({ ok: false, error: "sign in required" }, { status: 401, headers: noStore })
  const input = (request.json catch () => undefined) as { type?: unknown } | undefined
  if (input == undefined || typeof input.type != "string" || !policy.events.includes(input.type as string)) {
    return try HttpServerResponse.json({ ok: false, error: "This event is not yours to send." }, { status: 403, headers: noStore })
  }
  try observeFirstSeen(wallet)
  const bound = input as Record<string, unknown>
  for (const field of policy.bind ?? []) {
    if (field in bound) bound[field] = wallet
  }
  const sent = m.receive(bound, policy.sender == true ? wallet : undefined) catch (error) => error
  const rejected = sent as { _tag?: string }
  if (rejected && typeof rejected === "object" && "_tag" in rejected) {
    const status = rejected._tag === "NotAnEvent" ? 400 : rejected._tag === "Rejected" ? 409 : 500
    return try HttpServerResponse.json({ ok: false, error: rejected._tag }, { status, headers: noStore })
  }
  const scoped = scoping.project != undefined ? scoping.project(sent, wallet) : sent
  return try HttpServerResponse.json({ ok: true, state: scoped }, { headers: noStore })
}

// spec/app/session.md, "Only an active session can sign out": a stream opened for one session is
// bound to it for life. Every frame is revalidated against the live signing state, so no frame
// crosses after the session ends — sign-out or wall-clock expiry alike. The connection itself is
// interrupted as soon as the session machine publishes a state in which the credential is no
// longer active; a quiet server publishes nothing, so an idle connection can stay open past
// expiry, but nothing crosses it in either case.
function sessionBound<A>(frames: Stream.Stream<A>, sessions: Session.Machine.Shape, digest: string): Stream.Stream<A> {
  const revocation = effect {
    for try (const state of sessions.changes) {
      if (Session.activeWallet(state, digest, Date.now()) == "") break
    }
  }
  return frames.pipe(
    Stream.takeWhileEffect(effect () => {
      return Session.activeWallet(try sessions.get(), digest, Date.now()) != ""
    }),
    Stream.interruptWhen(revocation),
  )
}

/** Frames revalidated against the session they were opened with, for every wallet-scoped stream endpoint. */
export effect function sessionBoundFrames<A>(frames: Stream.Stream<A>, wallet: string, digest: string) {
  if (wallet == "") return frames
  const sessions = try Session.Machine
  return sessionBound(frames, sessions, digest)
}

// SSE comment frames never surface as message events in the browser; they exist so an idle
// connection still carries bytes — intermediaries drop silent connections, and a dropped one
// otherwise goes unnoticed until the next frame. Merged inside the session binding, each
// heartbeat is also a revalidation point, so a quiet connection cannot linger past expiry.
function heartbeats(): Stream.Stream<string> {
  return Stream.map(Stream.fromSchedule(Schedule.spaced("20 seconds")), () => ": hb\n\n")
}

/** One text/event-stream response carrying encoded frames plus heartbeat comments. */
export function sseResponse(pushes: Stream.Stream<string>) {
  return HttpServerResponse.stream(Stream.encodeText(Stream.merge(pushes, heartbeats())), {
    contentType: "text/event-stream",
    headers: noStore,
  })
}

/** sseResponse with every frame — heartbeats included — bound to the opening session. */
export effect function sessionBoundSse(pushes: Stream.Stream<string>, wallet: string, digest: string) {
  const bound = try sessionBoundFrames(Stream.merge(pushes, heartbeats()), wallet, digest)
  return HttpServerResponse.stream(Stream.encodeText(bound), {
    contentType: "text/event-stream",
    headers: noStore,
  })
}

effect function getStream(m: MachineLike, scoping: Scoping) {
  const session = try authenticatedSession()
  const wallet = session.wallet
  if (scoping.visibility != "public" && wallet == "") return try HttpServerResponse.json({ error: "sign in required" }, { status: 401, headers: noStore })
  try observeFirstSeen(wallet)
  const pushes = Stream.map(m.changes, (raw) => {
    const state = scoping.project != undefined && wallet != "" ? scoping.project(raw, wallet) : raw
    return `data: ${JSON.stringify(state)}\n\n`
  })
  return try sessionBoundSse(pushes, wallet, session.digest)
}

effect function getFleetState(fleet: Fleet.Shape, name: string) {
  const wallet = try authenticatedWallet()
  if (wallet == "") return try HttpServerResponse.json({ error: "sign in required" }, { status: 401, headers: noStore })
  try observeFirstSeen(wallet)
  const machine = try fleet.machine(name, wallet)
  return try HttpServerResponse.json(try machine.get(), { headers: noStore })
}

effect function getFleetStream(fleet: Fleet.Shape, name: string) {
  const session = try authenticatedSession()
  const wallet = session.wallet
  if (wallet == "") return try HttpServerResponse.json({ error: "sign in required" }, { status: 401, headers: noStore })
  try observeFirstSeen(wallet)
  const machine = try fleet.machine(name, wallet)
  const pushes = Stream.map(machine.changes, (state) => `data: ${JSON.stringify(state)}\n\n`)
  return try sessionBoundSse(pushes, wallet, session.digest)
}

effect function postFleetEvent(fleet: Fleet.Shape, name: string, policy: WritePolicy) {
  const request = try HttpServerRequest.HttpServerRequest
  if (!request.headers["content-type"]?.startsWith("application/json")) {
    return try HttpServerResponse.json({ error: "send application/json" }, { status: 415, headers: noStore })
  }
  const wallet = try authenticatedWallet()
  if (wallet == "") return try HttpServerResponse.json({ ok: false, error: "sign in required" }, { status: 401, headers: noStore })
  const input = (request.json catch () => undefined) as { type?: unknown } | undefined
  if (input == undefined || typeof input.type != "string" || !policy.events.includes(input.type as string)) {
    return try HttpServerResponse.json({ ok: false, error: "This event is not yours to send." }, { status: 403, headers: noStore })
  }
  try observeFirstSeen(wallet)
  const bound = input as Record<string, unknown>
  for (const field of policy.bind ?? []) {
    if (field in bound) bound[field] = wallet
  }
  const machine = try fleet.machine(name, wallet)
  const sent = machine.receive(bound) catch (error) => error
  const rejected = sent as { _tag?: string }
  if (rejected && typeof rejected === "object" && "_tag" in rejected) {
    const status = rejected._tag === "NotAnEvent" ? 400 : rejected._tag === "Rejected" ? 409 : 500
    return try HttpServerResponse.json({ ok: false, error: rejected._tag }, { status, headers: noStore })
  }
  return try HttpServerResponse.json({ ok: true, state: sent }, { headers: noStore })
}

/** state, event and stream endpoints over the requesting wallet's own instance of a per-wallet machine. */
export function fleetMachineApi(name: string, policy: WritePolicy = { events: [] }) {
  return Layer.unwrap(effect {
    const fleet = try Fleet
    return Layer.mergeAll(
      HttpRouter.add("GET", `/api/machines/${name}`, getFleetState(fleet, name)),
      HttpRouter.add("POST", `/api/machines/${name}`, provideService(postFleetEvent(fleet, name, policy), HttpServerRequest.MaxBodySize, ByteSize.kibibytes(256))),
      HttpRouter.add("GET", `/api/machines/${name}/stream`, getFleetStream(fleet, name)),
    )
  })
}

effect function getMultiplexedStream(registry: MachineRegistry.Shape) {
  const session = try authenticatedSession()
  const wallet = session.wallet
  const machines = try registry.entries()
  const visible = machines.filter(([, entry]) => entry.scoping.visibility == "public" || (entry.scoping.visibility == "user" && wallet != ""))
  const streams = visible.map(([name, entry]) => Stream.map(entry.machine.changes, (raw) => {
    const state = entry.scoping.project != undefined && wallet != "" ? entry.scoping.project(raw, wallet) : raw
    return `data: ${JSON.stringify({ machine: name, state })}\n\n`
  }))
  const merged = Stream.mergeAll(streams, { concurrency: "unbounded" })
  return try sessionBoundSse(merged, wallet, session.digest)
}

const multiplexedMachines = Layer.provideMerge(
  Layer.unwrap(effect {
    const registry = try MachineRegistry
    return HttpRouter.add("GET", "/api/machines/stream", getMultiplexedStream(registry))
  }),
  machineRegistry,
)

/** state and stream endpoints over one spec machine whose writes have a guarded route elsewhere. */
export function machineReadApi(name: string, m: MachineLike, scoping: Scoping = { visibility: "user" }) {
  return Layer.mergeAll(
    HttpRouter.add("GET", `/api/machines/${name}`, getState(m, scoping)),
    HttpRouter.add("GET", `/api/machines/${name}/stream`, getStream(m, scoping)),
    machineRegistration(name, m, scoping),
    multiplexedMachines,
  )
}

/** state, event and stream endpoints over one spec machine, mounted at /api/machines/<name>. */
export function machineApi(name: string, m: MachineLike, policy: WritePolicy = { events: [] }, scoping: Scoping = { visibility: "user" }) {
  return Layer.mergeAll(
    HttpRouter.add("GET", `/api/machines/${name}`, getState(m, scoping)),
    HttpRouter.add("POST", `/api/machines/${name}`, provideService(postEvent(m, policy, scoping), HttpServerRequest.MaxBodySize, ByteSize.kibibytes(256))),
    HttpRouter.add("GET", `/api/machines/${name}/stream`, getStream(m, scoping)),
    machineRegistration(name, m, scoping),
    multiplexedMachines,
  )
}
