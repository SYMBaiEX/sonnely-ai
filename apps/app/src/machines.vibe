// A domain area (spec/app/<area>.md -> gen/app__<area>.ts) mounts `machineApi("<area>", try Machine)`
// in its src/api/<area>.vibe, stored server-side as `Layer.provide(stored("<area>"), store(dir))`.

export interface MachineLike {
  get(): unknown!!
  // eslint-disable-next-line @typescript-eslint/no-explicit-any -- the channel payload type is erased at the protocol boundary
  receive(input: unknown): any!any
  changes: Stream.Stream<unknown>
}

export interface MachineReader {
  changes: Stream.Stream<unknown>
}

service MachineRegistry {
  static readonly key = "@repo/app/machines/MachineRegistry"
  register(name: string, machine: MachineReader): void!!
  entries(): Array<readonly [string, MachineReader]>!!
}

const machineRegistry = Layer.effect(MachineRegistry, effect {
  const machines = try Ref.make(new Map<string, MachineReader>())
  return {
    effect register(name: string, machine: MachineReader) {
      try Ref.update(machines, (current) => {
        const next = new Map(current)
        next.set(name, machine)
        return next
      })
    },
    effect entries() {
      return Array.from((try Ref.get(machines)).entries())
    },
  }
})

function registrationLayer(name: string, machine: MachineReader) {
  return Layer.effectDiscard(effect {
    const registry = try MachineRegistry
    try registry.register(name, machine)
  })
}

export function machineRegistration(name: string, machine: MachineReader) {
  return Layer.provideMerge(registrationLayer(name, machine), machineRegistry)
}

const noStore = { "cache-control": "no-store" }

effect function getState(m: MachineLike) {
  return try HttpServerResponse.json(try m.get(), { headers: noStore })
}

effect function postEvent(m: MachineLike) {
  const request = try HttpServerRequest.HttpServerRequest
  if (!request.headers["content-type"]?.startsWith("application/json")) {
    return try HttpServerResponse.json({ error: "send application/json" }, { status: 415, headers: noStore })
  }
  const input = request.json catch () => undefined
  const sent = m.receive(input) catch (error) => error
  const rejected = sent as { _tag?: string; state?: unknown }
  if (rejected && typeof rejected === "object" && "_tag" in rejected) {
    const status = rejected._tag === "NotAnEvent" ? 400 : rejected._tag === "Rejected" ? 409 : 500
    return try HttpServerResponse.json({ ok: false, error: rejected._tag, state: rejected.state }, { status, headers: noStore })
  }
  return try HttpServerResponse.json({ ok: true, state: sent }, { headers: noStore })
}

effect function getStream(m: MachineLike) {
  const pushes = Stream.map(m.changes, (s) => `data: ${JSON.stringify(s)}\n\n`)
  return HttpServerResponse.stream(Stream.encodeText(pushes), {
    contentType: "text/event-stream",
    headers: { ...noStore, connection: "keep-alive" },
  })
}

effect function getMultiplexedStream(registry: MachineRegistry.Shape) {
  const machines = try registry.entries()
  const streams = machines.map(([name, machine]) => Stream.map(machine.changes, (state) => `data: ${JSON.stringify({ machine: name, state })}\n\n`))
  return HttpServerResponse.stream(Stream.encodeText(Stream.mergeAll(streams, { concurrency: "unbounded" })), {
    contentType: "text/event-stream",
    headers: { ...noStore, connection: "keep-alive" },
  })
}

const multiplexedMachines = Layer.provideMerge(
  Layer.unwrap(effect {
    const registry = try MachineRegistry
    return HttpRouter.add("GET", "/api/machines/stream", getMultiplexedStream(registry))
  }),
  machineRegistry,
)

/** state, event and stream endpoints over one spec machine, mounted at /api/machines/<name>. */
export function machineApi(name: string, m: MachineLike) {
  return Layer.mergeAll(
    HttpRouter.add("GET", `/api/machines/${name}`, getState(m)),
    HttpRouter.add("POST", `/api/machines/${name}`, provideService(postEvent(m), HttpServerRequest.MaxBodySize, ByteSize.kibibytes(256))),
    HttpRouter.add("GET", `/api/machines/${name}/stream`, getStream(m)),
    machineRegistration(name, m),
    multiplexedMachines,
  )
}
