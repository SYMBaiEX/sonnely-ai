// spec/app/compute/instances.md, "Story: Rent a confidential machine"
// The runs of src/api/compute/instances.vibe: a Blackbox is launched, verified, stopped and settled,
// a Dry Dock runs its build and completes, and an event is only applied when the rules allow it.
import { assert, layer } from "@effect/vitest"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import type { Compute } from "../gen/app__compute__instances.ts"
import { Machine } from "../gen/app__compute__instances.effect.vibe"
import { dispatch, instances } from "../src/api/compute/instances.vibe"

const blackbox = { tag: "Blackbox", image: "docker.io/library/nginx@sha256:" + "a".repeat(64), port: 8080, machine: "tdx.small", disk: 20 } as const
const drydock = { tag: "DryDock", repository: "https://github.com/sonnely/sonnely", revision: "a".repeat(40) } as const

effect function state() {
  provide instances { return try (try Machine).get() }
}

function run(state: Compute, id: string) {
  return state.runs.find((r) => r.id === id)
}

layer(KeyValueStore.layerMemory)((it) => {
  // spec/app/compute/instances.md, "Story: Rent a confidential machine"
  it.effect("A Blackbox is launched, verified, stopped and settled", () => effect {
    provide instances {
      try dispatch({ type: "open", id: "run-1", reference: "ref-1", wallet: "wallet-a", spec: blackbox, minutes: 15 })
      try dispatch({ type: "launch", id: "run-1" })
      try dispatch({ type: "attest", id: "run-1" })
      const running = try (try Machine).get()
      // spec/app/compute/instances.md, "A Blackbox only serves inference once its attestation is verified"
      try Effect.try(() => {
        const x = running.runs[0]
        assert.strictEqual(x.phase, "Running")
        assert.strictEqual(x.attestation, "Verified")
      })
      try dispatch({ type: "stop", id: "run-1" })
      try dispatch({ type: "tearDown", id: "run-1", result: "Stopped" })
      try dispatch({ type: "settleRun", id: "run-1", seconds: 300, metered: 0 })
    }
    const after = try state()
    const x = run(after, "run-1")
    try Effect.try(() => {
      assert.ok(x)
      assert.strictEqual(x.phase, "Settled")
      assert.strictEqual(x.result, "Stopped")
      // spec/app/compute/instances.md, "A charge never exceeds the hold, and the hold is charge plus what returned"
      assert.ok(x.charged <= x.reserve)
      assert.strictEqual(x.charged + x.returned, x.reserve)
    })
  })

  // spec/app/compute/instances.md, "Story: Rent a confidential machine"
  it.effect("A Dry Dock runs its build and settles its metered time", () => effect {
    provide instances {
      try dispatch({ type: "open", id: "run-2", reference: "ref-2", wallet: "wallet-b", spec: drydock, minutes: 5 })
      try dispatch({ type: "launch", id: "run-2" })
      try dispatch({ type: "work", id: "run-2" })
      try dispatch({ type: "tearDown", id: "run-2", result: "Completed" })
      try dispatch({ type: "settleRun", id: "run-2", seconds: 120, metered: 1000 })
    }
    const after = try state()
    const x = run(after, "run-2")
    try Effect.try(() => {
      assert.ok(x)
      assert.strictEqual(x.phase, "Settled")
      assert.strictEqual(x.result, "Completed")
      // spec/app/compute/instances.md, "A running Blackbox is always verified, and a Dry Dock never needs evidence"
      assert.strictEqual(x.attestation, "Absent")
      assert.ok(x.charged > 0)
      assert.ok(x.charged <= x.reserve)
      assert.strictEqual(x.charged + x.returned, x.reserve)
    })
  })

  // spec/app/compute/instances.md, "A wallet can run one compute job at a time"
  it.effect("A wallet is refused a second active run", () => effect {
    const before = try state()
    let failed = ""
    provide instances {
      try dispatch({ type: "open", id: "run-3", reference: "ref-3", wallet: "wallet-c", spec: blackbox, minutes: 15 })
      const outcome = dispatch({ type: "open", id: "run-4", reference: "ref-4", wallet: "wallet-c", spec: blackbox, minutes: 15 }) catch (error) => (error as { _tag: string })._tag
      failed = typeof outcome === "string" ? outcome : "accepted"
    }
    try Effect.try(() => assert.strictEqual(failed, "Rejected"))
    const after = try state()
    try Effect.try(() => {
      assert.strictEqual(after.runs.length, before.runs.length + 1)
      assert.ok(!run(after, "run-4"))
    })
  })

  // spec/app/compute/instances.md, "Run ids and a wallet's references are never reused"
  it.effect("Opening the same reference again returns the run it opened", () => effect {
    const before = try state()
    provide instances {
      try dispatch({ type: "open", id: "run-5", reference: "ref-5", wallet: "wallet-d", spec: blackbox, minutes: 15 })
      try dispatch({ type: "open", id: "run-6", reference: "ref-5", wallet: "wallet-d", spec: blackbox, minutes: 15 })
    }
    const after = try state()
    try Effect.try(() => {
      assert.strictEqual(after.runs.length, before.runs.length + 1)
      assert.strictEqual(run(after, "run-5")?.reference, "ref-5")
      assert.ok(!run(after, "run-6"))
    })
  })
})
