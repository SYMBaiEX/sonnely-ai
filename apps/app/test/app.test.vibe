// spec/app/nav.md, "Story: Move around"
// The navigator of src/web/nav.vibe: pages open and are found again, across a page opened again.
import { assert, layer } from "@effect/vitest"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import { Machine } from "../gen/app__nav.effect.vibe"
import { back, dispatch, nav, open } from "../src/web/nav.vibe"

effect function page() {
  provide nav { return try (try Machine).get() }
}

layer(KeyValueStore.layerMemory)((it) => {
  // spec/app/nav.md, "Story: Move around"
  it.effect("Open a page, then find the way back", () => effect {
    provide nav {
      try open({ tag: "Models" })
      try open({ tag: "Status" })
      try back()
    }
    const after = try page()
    try Effect.try(() => assert.deepStrictEqual(after.page, { tag: "Models" }))
    // spec/app/nav.md, "Going back is possible only after opening a page"
    try Effect.try(() => assert.deepStrictEqual(after.back.length, 1))
  })

  // spec/app/nav.md, "Any page can be opened"
  it.effect("An event that is not one is refused", () => effect {
    let failed = "accepted"
    provide nav {
      const outcome = dispatch({ type: "open", page: { tag: "Nope" } }) catch (error) => (error as { _tag: string })._tag
      failed = typeof outcome === "string" ? outcome : "accepted"
    }
    try Effect.try(() => assert.strictEqual(failed, "NotAnEvent"))
  })
})
