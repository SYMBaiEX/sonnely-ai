{
  "name": "sonnely-sdk",
  "version": "0.1.2",
  "description": "Typed server-side client for the Sonnely inference API",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "eventsource-parser": "^3.1.1"
  },
  "homepage": "https://docs.sonnely.com/docs/sdks",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
