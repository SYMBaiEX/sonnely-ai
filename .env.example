# Server-only. Use the identical high-entropy value in Convex and the frontend host.
CONVEX_URL=
SONNELY_SERVICE_SECRET=
# Managed inference. Optional until an approved provider account is ready.
NEAR_AI_API_KEY=
# Separate Phala Private AI inference key, not the Phala Cloud CLI token.
PHALA_AI_API_KEY=
# Separate Tinfoil inference key.
TINFOIL_API_KEY=
# Use one wallet for a private production pilot or explicitly opt in to public access.
SONNELY_PILOT_WALLET=
SONNELY_PUBLIC_INFERENCE=false
# Billing remains disabled until both the treasury wallet and a Solana devnet RPC are set.
SOLANA_TREASURY=
SOLANA_RPC_URL=
# Set alongside your chosen treasury/RPC to opt into mainnet. Defaults to devnet.
SOLANA_BILLING_CLUSTER=devnet
# 1Click Distribution Channel credential for mainnet wallet swaps.
NEAR_INTENTS_API_KEY=

# Set these on the Convex deployment, not in a browser-facing environment.
SONNELY_ADMIN_WALLETS=
SONNELY_TREASURY_WALLET=
SONNELY_PROFIT_WALLET=
# Set on Convex as well for the mainnet deposit recovery cron.
# SOLANA_RPC_URL=


# UsageMax gateway receipts. Set the project write credential on Convex and the
# project reporting credential on the frontend host. These are server-only.
USAGEMAX_GATEWAY_INGEST_TOKEN=
USAGEMAX_GATEWAY_REPORT_TOKEN=
# Optional UsageMax project ID for receipt links in Admin.
USAGEMAX_GATEWAY_PROJECT_ID=

# Operations tokens are server-only. Set identical values on Vercel and Convex.
SONNELY_OPERATIONS_TOKEN=
SONNELY_INVOICE_IMPORT_TOKEN=
# These values are for Vercel. Set the same bridge token on the mail Worker.
SONNELY_MAIL_BRIDGE_URL=
SONNELY_MAIL_BRIDGE_TOKEN=
# Set on Convex when the mail Worker has a verified destination.
SONNELY_EMAIL_ENABLED=false
