{
  "name": "sonnely",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build --filter=!vibestack",
    "start": "pnpm -C apps/app start",
    "studio": "node packages/vibestack/src/spec.ts studio",
    "check": "node packages/vibestack/src/spec.ts check",
    "gen": "node packages/vibestack/src/spec.ts gen",
    "accept": "node packages/vibestack/src/spec.ts accept",
    "new": "node packages/vibestack/src/spec.ts new",
    "upgrade": "node packages/vibestack/src/spec.ts upgrade",
    "doctor": "node packages/vibestack/src/spec.ts doctor",
    "postinstall": "node packages/vibestack/src/spec.ts link",
    "test": "vitest run",
    "test:browser": "node packages/vibestack/src/spec.ts tasks --filter=!vibestack test:browser",
    "typecheck": "vibelang --noEmit -p tsconfig.json",
    "lint": "node packages/vibestack/src/spec.ts tasks --filter=!vibestack //#lint:js //#lint:css",
    "lint:js": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input",
    "lint:design": "node scripts/design-eslint-baseline.mjs",
    "lint:design:write": "node scripts/design-eslint-baseline.mjs --write",
    "quick": "node packages/vibestack/src/spec.ts tasks --filter=!vibestack typecheck test //#lint:js //#lint:css",
    "verify": "node packages/vibestack/src/spec.ts tasks --filter=!vibestack build typecheck test test:browser check //#lint:js //#lint:css",
    "all": "node packages/vibestack/src/spec.ts tasks --filter=!vibestack"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.1",
    "@eslint-react/eslint-plugin": "catalog:",
    "@eslint/js": "catalog:",
    "@repo/design-system": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-better-tailwindcss": "catalog:",
    "eslint-plugin-boundaries": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "happy-dom": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-standard": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vibelang": "0.0.13",
    "vibelang-vite": "0.0.13",
    "vibestack": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
